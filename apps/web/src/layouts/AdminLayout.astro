---
import '../styles/global.css';
import { formatPageTitle } from '../lib/branding';

export interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Admin', activeNav = 'admin-dashboard' } = Astro.props;
const formattedTitle = formatPageTitle(title);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{formattedTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
  <link rel="shortcut icon" href="/favicon.ico?v=3" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />

  <!-- Instant Site Branding Pre-Hydration (Zero FOUC) -->
  <script is:inline>
    (function() {
      try {
        var rawB = localStorage.getItem('otpwala_branding');
        if (rawB) {
          var b = JSON.parse(rawB);
          var bName = b.brandName || 'OTPWala';
          var bSep = b.separator || '—';
          var parts = document.title.split(/ [—|•-] /);
          var prefix = parts[0] ? parts[0].trim() : '';
          if (prefix && prefix !== bName) {
            document.title = prefix + ' ' + bSep + ' ' + bName;
          }
        }
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <div class="dashboard-layout">
    <aside class="sidebar">
      <div class="sidebar-header">
        <a href="/" class="logo">
          <span class="logo-icon">
            <svg width="32" height="32" viewBox="0 0 512 512" fill="none" aria-hidden="true">
              <defs>
                <linearGradient id="admLogoBg" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0f172a" />
                  <stop offset="35%" stop-color="#1e1b4b" />
                  <stop offset="70%" stop-color="#1d4ed8" />
                  <stop offset="100%" stop-color="#0284c7" />
                </linearGradient>
                <radialGradient id="admLogoCenterGlow" cx="50%" cy="48%" r="50%">
                  <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.25" />
                  <stop offset="100%" stop-color="#0284c7" stop-opacity="0" />
                </radialGradient>
                <linearGradient id="admLogoORingGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="50%" stop-color="#f0f9ff" />
                  <stop offset="100%" stop-color="#bae6fd" />
                </linearGradient>
                <linearGradient id="admLogoWLeftGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#38bdf8" />
                  <stop offset="100%" stop-color="#2563eb" />
                </linearGradient>
                <linearGradient id="admLogoWRightGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#60a5fa" />
                  <stop offset="100%" stop-color="#1d4ed8" />
                </linearGradient>
                <linearGradient id="admLogoVaultCoreGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#10b981" />
                  <stop offset="100%" stop-color="#06b6d4" />
                </linearGradient>
                <filter id="admLogoMainShadow" x="-20%" y="-20%" width="140%" height="140%">
                  <feDropShadow dx="0" dy="12" stdDeviation="16" flood-color="#020617" flood-opacity="0.5" />
                </filter>
              </defs>
              <rect x="16" y="16" width="480" height="480" rx="118" fill="url(#admLogoBg)" />
              <rect x="16" y="16" width="480" height="480" rx="118" fill="url(#admLogoCenterGlow)" />
              <rect x="18" y="18" width="476" height="476" rx="116" fill="none" stroke="rgba(255, 255, 255, 0.22)" stroke-width="3" />
              <path d="M 16 134 C 16 50 50 16 134 16 L 378 16 C 462 16 496 50 496 134 L 496 220 C 330 255 182 255 16 220 Z" fill="#ffffff" opacity="0.08" />
              <g filter="url(#admLogoMainShadow)">
                <path d="M 256,76 C 358,76 436,154 436,256 C 436,334 372,398 256,436 C 140,398 76,334 76,256 C 76,154 154,76 256,76 Z M 256,134 C 188,134 134,188 134,256 C 134,312 180,360 256,388 C 332,360 378,312 378,256 C 378,188 324,134 256,134 Z" fill="url(#admLogoORingGrad)" fill-rule="evenodd" />
                <path d="M 172,216 L 208,216 L 236,326 L 204,326 Z" fill="url(#admLogoWLeftGrad)" />
                <path d="M 204,326 L 236,326 L 256,254 L 238,254 Z" fill="#60a5fa" />
                <path d="M 256,254 L 274,254 L 308,326 L 276,326 Z" fill="#3b82f6" />
                <path d="M 304,216 L 340,216 L 308,326 L 276,326 Z" fill="url(#admLogoWRightGrad)" />
                <rect x="172" y="212" width="36" height="6" rx="3" fill="#ffffff" />
                <rect x="304" y="212" width="36" height="6" rx="3" fill="#ffffff" />
                <circle cx="256" cy="186" r="16" fill="url(#admLogoVaultCoreGrad)" />
                <path d="M 248,194 L 264,194 L 267,222 L 245,222 Z" fill="url(#admLogoVaultCoreGrad)" />
                <polyline points="250,186 254,190 262,182" fill="none" stroke="#ffffff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M 364,136 C 382,152 392,174 394,198" fill="none" stroke="#38bdf8" stroke-width="8" stroke-linecap="round" />
                <path d="M 396,108 C 422,132 436,162 438,198" fill="none" stroke="#38bdf8" stroke-width="8" stroke-linecap="round" opacity="0.8" />
                <circle cx="406" cy="98" r="9" fill="#10b981" />
                <circle cx="406" cy="98" r="4.5" fill="#ffffff" />
              </g>
            </svg>
          </span>
          <span class="logo-text"><span data-brand-name>OTPWala</span></span>
        </a>
        <span class="badge badge-error" style="margin-left: 0.5rem; font-size: 0.65rem;">ADMIN</span>
      </div>

      <nav class="sidebar-nav">
        <a href="/admin" class={`nav-item ${activeNav === 'admin-dashboard' ? 'active' : ''}`}>
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" />
            </svg>
          </span>
          <span>Overview</span>
        </a>
        <a href="/admin/pricing" class={`nav-item ${activeNav === 'admin-pricing' ? 'active' : ''}`}>
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23" /><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
            </svg>
          </span>
          <span>Pricing</span>
        </a>
        <a href="/admin/catalog" class={`nav-item ${activeNav === 'admin-catalog' ? 'active' : ''}`}>
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            </svg>
          </span>
          <span>Catalog & Services</span>
        </a>
        <a href="/admin/users" class={`nav-item ${activeNav === 'admin-users' ? 'active' : ''}`}>
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </span>
          <span>Users</span>
        </a>
        <a href="/admin/recharges" class={`nav-item ${activeNav === 'admin-recharges' ? 'active' : ''}`}>
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" />
            </svg>
          </span>
          <span>Recharges</span>
        </a>
        <a href="/admin/orders" class={`nav-item ${activeNav === 'admin-orders' ? 'active' : ''}`}>
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" ry="1" /><line x1="9" y1="12" x2="15" y2="12" /><line x1="9" y1="16" x2="15" y2="16" />
            </svg>
          </span>
          <span>Orders</span>
        </a>
        <a href="/admin/settings" class={`nav-item ${activeNav === 'admin-settings' ? 'active' : ''}`}>
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
            </svg>
          </span>
          <span>Settings</span>
        </a>

        <div class="nav-divider"></div>

        <a href="/dashboard" class="nav-item">
          <span class="nav-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 14 4 9 9 4" /><path d="M20 20v-7a4 4 0 0 0-4-4H4" />
            </svg>
          </span>
          <span>Back to Dashboard</span>
        </a>
      </nav>

      <div class="sidebar-footer">
        <button class="btn btn-ghost btn-sm" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem;" id="admin-logout-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>Log Out</span>
        </button>
      </div>
    </aside>
    <div class="sidebar-backdrop" id="admin-sidebar-backdrop"></div>

    <div class="dashboard-main">
      <header class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; padding: 0 var(--space-xl);">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <button class="btn btn-ghost btn-icon mobile-menu-btn" id="admin-mobile-menu-btn" aria-label="Open Admin Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </button>
          <div style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600;"><span data-brand-name>OTPWala</span> Admin Operations</div>
        </div>
        <div id="admin-tiger-status-indicator" style="display: flex; align-items: center; gap: 0.5rem;">
          <div class="system-status-pill" id="tiger-status-badge" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); color: #34d399;" title="Upstream Tiger SMS API Gateway Connectivity">
            <span class="status-dot active pulse-dot" id="tiger-status-dot"></span>
            <span id="tiger-status-text">Tiger SMS: Checking...</span>
          </div>
        </div>
      </header>
      <main class="dashboard-content">
        <slot />
      </main>
    </div>
  </div>

  <style>
    .dashboard-layout { display: flex; min-height: 100vh; }
    .sidebar { width: var(--sidebar-width); background: var(--bg-secondary); border-right: 1px solid var(--border-subtle); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0; z-index: 100; transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1); }
    .sidebar-header { padding: var(--space-lg); border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; }
    .sidebar-nav { flex: 1; padding: var(--space-md); display: flex; flex-direction: column; gap: 0.25rem; }
    .nav-item { display: flex; align-items: center; gap: var(--space-sm); padding: 0.65rem 0.85rem; border-radius: var(--radius-md); color: var(--text-secondary); font-size: 0.9rem; font-weight: 500; transition: all var(--transition-fast); text-decoration: none; }
    .nav-item:hover { background: var(--bg-glass); color: var(--text-primary); }
    .nav-item.active { background: var(--accent-glow); color: var(--accent-primary); border: 1px solid var(--border-glow); }
    .nav-icon { font-size: 1.1rem; width: 24px; text-align: center; }
    .nav-divider { height: 1px; background: var(--border-subtle); margin: var(--space-sm) 0; }
    .sidebar-footer { padding: var(--space-md); border-top: 1px solid var(--border-subtle); }
    .dashboard-main { flex: 1; margin-left: var(--sidebar-width); display: flex; flex-direction: column; min-width: 0; width: calc(100% - var(--sidebar-width)); }
    .dashboard-header { height: var(--header-height); border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; padding: 0 var(--space-xl); background: rgba(255,255,255,0.85); backdrop-filter: blur(20px); position: sticky; top: 0; z-index: 50; }
    .dashboard-content { flex: 1; padding: var(--space-xl); max-width: 1200px; width: 100%; min-width: 0; overflow-x: hidden; }
    .mobile-menu-btn { display: none; }

    @media (max-width: 768px) {
      .sidebar {
        transform: translateX(-100%);
      }
      .sidebar.open {
        transform: translateX(0);
      }
      .dashboard-main {
        margin-left: 0;
        width: 100%;
      }
      .mobile-menu-btn {
        display: flex;
      }
      .dashboard-header {
        padding: 0 1rem !important;
      }
      .dashboard-content {
        padding: 1rem !important;
      }
    }
    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      font-family: var(--font-display, 'Outfit', -apple-system, sans-serif);
      font-weight: 800;
      font-size: 1.35rem;
      letter-spacing: -0.025em;
      line-height: 1;
      user-select: none;
    }
    .logo-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: transform var(--transition-fast);
    }
    .logo:hover .logo-icon { transform: scale(1.05); }
    .logo-text {
      color: #0f172a;
      display: inline-flex;
      align-items: center;
      font-weight: 800;
      letter-spacing: -0.025em;
    }
    .logo-text .text-gradient { color: #2563eb; font-weight: 800; }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    import {
      getLocalSessionId,
      registerCurrentSession,
      verifyActiveSession,
      handleSessionTermination,
      startSessionHeartbeat,
      clearLocalSessionId,
      getOrWaitForSession,
      getStoredSessionSync,
    } from '../lib/sessionManager';
    import { getAdminTigerBalance } from '../lib/api';

    (async () => {
      // 0. Synchronous instant check from localStorage (0ms)
      let session = getStoredSessionSync();
      if (!session?.user) {
        session = await getOrWaitForSession(3000);
      }

      if (!session?.user) {
        // Double-check if token exists in localStorage before redirecting
        const hasStoredToken = typeof localStorage !== 'undefined' && Object.keys(localStorage).some(
          k => k.startsWith('sb-') && k.endsWith('-auth-token')
        );
        if (!hasStoredToken) {
          window.location.href = '/auth/login';
          return;
        }
      }

      // NOTE: We do NOT call supabase.auth.getUser() here.
      // getOrWaitForSession() already returns a cryptographically valid session.
      // Calling getUser() adds a network round-trip that can fail and incorrectly log out the admin.

      // 1. Verify admin profile - with network failure tolerance
      let profile: any = null;
      try {
        const { data } = await supabase
          .from('profiles')
          .select('role, is_banned')
          .eq('id', session.user.id)
          .maybeSingle();
        profile = data;
      } catch (e) {
        console.warn('Could not fetch admin profile (network error), retrying via ensure-profile...');
      }

      if (!profile) {
        // Attempt to auto-ensure profile exists via API before deciding
        try {
          const apiUrl = (import.meta.env.PUBLIC_API_URL || '');
          const ensureRes = await fetch(apiUrl + '/api/auth/ensure-profile', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${session.access_token}`,
            },
          });
          if (ensureRes.ok) {
            const ensureData = await ensureRes.json();
            if (ensureData?.profile) {
              profile = ensureData.profile;
            }
          }
        } catch {}
      }

      if (profile?.is_banned === true) {
        await handleSessionTermination('account_banned');
        return;
      }

      // Non-admin authenticated users should go to customer dashboard
      if (profile && profile.role !== 'admin' && profile.role !== 'superadmin') {
        window.location.href = '/dashboard';
        return;
      }

      // If profile is null (network failure), allow admin to stay - don't kick on uncertainty
      // They'll be blocked by API calls if truly unauthorized

      // 2. Device session registration
      if (!getLocalSessionId()) {
        registerCurrentSession(session.access_token).catch(() => {});
      }

      // 3. Auth state listener - ignore transient SIGNED_OUT during token refresh
      let signedOutTimer: ReturnType<typeof setTimeout> | null = null;
      supabase.auth.onAuthStateChange((event, newSession) => {
        if (event === 'SIGNED_OUT') {
          signedOutTimer = setTimeout(() => {
            clearLocalSessionId();
            window.location.href = '/auth/login';
          }, 3000);
        } else if (event === 'SIGNED_IN' || event === 'TOKEN_REFRESHED') {
          if (signedOutTimer) {
            clearTimeout(signedOutTimer);
            signedOutTimer = null;
          }
        }
      });

      // 4. Check Tiger SMS upstream status for Admin
      const checkTigerStatus = async () => {
        try {
          const data = await getAdminTigerBalance();
          const badge = document.getElementById('tiger-status-badge');
          const dot = document.getElementById('tiger-status-dot');
          const text = document.getElementById('tiger-status-text');
          if (data && data.balance !== undefined) {
            if (text) text.textContent = `Tiger SMS: Up & Operational`;
            if (badge) {
              badge.style.background = 'rgba(16, 185, 129, 0.1)';
              badge.style.borderColor = 'rgba(16, 185, 129, 0.25)';
              badge.style.color = '#34d399';
            }
            if (dot) {
              dot.className = 'status-dot active pulse-dot';
              dot.style.background = '#10b981';
            }
          } else {
            if (text) text.textContent = 'Tiger SMS: Offline / Issue';
            if (badge) {
              badge.style.background = 'rgba(239, 68, 68, 0.1)';
              badge.style.borderColor = 'rgba(239, 68, 68, 0.25)';
              badge.style.color = '#f87171';
            }
            if (dot) {
              dot.className = 'status-dot';
              dot.style.background = '#ef4444';
            }
          }
        } catch {
          const badge = document.getElementById('tiger-status-badge');
          const dot = document.getElementById('tiger-status-dot');
          const text = document.getElementById('tiger-status-text');
          if (text) text.textContent = 'Tiger SMS: Unreachable';
          if (badge) {
            badge.style.background = 'rgba(239, 68, 68, 0.1)';
            badge.style.borderColor = 'rgba(239, 68, 68, 0.25)';
            badge.style.color = '#f87171';
          }
          if (dot) {
            dot.className = 'status-dot';
            dot.style.background = '#ef4444';
          }
        }
      };

      checkTigerStatus();
    })();

    document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
      clearLocalSessionId();
      try {
        await supabase.auth.signOut({ scope: 'local' });
      } finally {
        window.location.replace('/auth/login');
      }
    });

    // Dynamic Branding Sync
    (function syncBranding() {
      function applyBrand(b) {
        if (!b) return;
        var bName = b.brandName || 'OTPWala';
        var bSep = b.separator || '—';
        if (document.title) {
          var parts = document.title.split(/ [—|•-] /);
          var prefix = parts[0] ? parts[0].trim() : '';
          if (prefix && prefix !== bName) {
            document.title = prefix + ' ' + bSep + ' ' + bName;
          }
        }
        document.querySelectorAll('[data-brand-name]').forEach(function(el) {
          el.textContent = bName;
        });
        document.querySelectorAll('[data-brand-separator]').forEach(function(el) {
          el.textContent = bSep;
        });
      }

      try {
        var cached = localStorage.getItem('otpwala_branding');
        if (cached) applyBrand(JSON.parse(cached));
      } catch(e) {}

      fetch('/api/branding')
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (json && json.success && json.data) {
            localStorage.setItem('otpwala_branding', JSON.stringify(json.data));
            applyBrand(json.data);
          }
        })
        .catch(function() {});

      // Admin mobile menu toggle
      var adminMenuBtn = document.getElementById('admin-mobile-menu-btn');
      var adminSidebar = document.querySelector('.sidebar');
      var adminBackdrop = document.getElementById('admin-sidebar-backdrop');
      function toggleAdmin() {
        var isOpen = adminSidebar && adminSidebar.classList.toggle('open');
        if (adminBackdrop) adminBackdrop.classList.toggle('active', !!isOpen);
        document.body.style.overflow = isOpen ? 'hidden' : '';
      }
      if (adminMenuBtn) adminMenuBtn.addEventListener('click', toggleAdmin);
      if (adminBackdrop) adminBackdrop.addEventListener('click', toggleAdmin);
      if (adminSidebar) {
        adminSidebar.querySelectorAll('.nav-item').forEach(function(item) {
          item.addEventListener('click', function() {
            if (window.innerWidth <= 768) {
              adminSidebar.classList.remove('open');
              if (adminBackdrop) adminBackdrop.classList.remove('active');
              document.body.style.overflow = '';
            }
          });
        });
      }
    })();
  </script>
</body>
</html>
