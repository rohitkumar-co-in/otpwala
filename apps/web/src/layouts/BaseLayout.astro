      -webkit-backdrop-filter: blur(24px) saturate(200%);
      border-bottom: 1px solid rgba(209, 213, 219, 0.8);
      box-shadow: 0 10px 30px -4px rgba(15, 23, 42, 0.08), 0 4px 10px -2px rgba(15, 23, 42, 0.03), inset 0 1px 0 0 rgba(255, 255, 255, 0.95);
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      font-family: var(--font-display, 'Outfit', -apple-system, sans-serif);
      font-weight: 800;
      font-size: 1.35rem;
      letter-spacing: -0.025em;
      line-height: 1;
      user-select: none;
    }
    .logo-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: transform var(--transition-fast);
    }
    .logo:hover .logo-icon {
      transform: scale(1.05);
    }
    .logo-text {
      color: #0f172a;
      display: inline-flex;
      align-items: center;
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1;
    }
    .logo-text .text-gradient {
      color: #2563eb;
      font-weight: 800;
    }

    .nav-links {
      display: flex;
      gap: 0.4rem;
      align-items: center;
      background: rgba(241, 245, 249, 0.55);
      padding: 4px 6px;
      border-radius: 9999px;
      border: 1px solid rgba(229, 231, 235, 0.65);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .nav-links a {
      color: #64748b;
      font-size: 0.86rem;
      font-weight: 500;
      padding: 0.4rem 0.9rem;
      border-radius: 9999px;
      text-decoration: none;
      transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .nav-links a:hover {
      color: #0f172a;
      background: rgba(255, 255, 255, 0.85);
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
    }
    .nav-links a.active {
      color: #2563eb;
      font-weight: 700;
      background: #ffffff;
      box-shadow: 0 2px 6px rgba(37, 99, 235, 0.15);
    }

    main {
      padding-top: var(--header-height);
      position: relative;
      z-index: 1;
    }

    /* ─── Footer ─── */
    .site-footer {
      background: #0f172a;
      padding: 3.5rem 0 1.5rem;
      margin-top: 0;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 2.5rem;
      margin-bottom: 2.5rem;
    }
    .footer-brand p {
      margin-top: 0.85rem;
      font-size: 0.88rem;
      color: #64748b;
      max-width: 280px;
      line-height: 1.65;
    }
    .footer-brand .logo-text { color: #f1f5f9; }
    .footer-brand .logo-dot  { color: #475569; }
    .footer-brand .logo svg  { stroke: #2563eb; }

    .footer-links {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .footer-links h4 {
      font-size: 0.75rem;
      font-weight: 700;
      color: #94a3b8;
      margin-bottom: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }
    .footer-links a {
      color: #64748b;
      font-size: 0.85rem;
      transition: color 0.15s;
    }
    .footer-links a:hover { color: #f1f5f9; }

    .footer-bottom {
      padding-top: 1.5rem;
      border-top: 1px solid #1e293b;
      text-align: center;
      font-size: 0.8rem;
      color: #475569;
    }

    /* Mobile Nav Drawer Styles */
    .mobile-nav-toggle {
      display: none;
      background: none;
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 0.4rem;
      cursor: pointer;
      color: var(--text-primary);
      align-items: center;
      justify-content: center;
      transition: background var(--transition-fast);
    }
    .mobile-nav-toggle:hover {
      background: var(--bg-glass);
    }

    .mobile-nav-drawer {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(24px) saturate(190%);
      -webkit-backdrop-filter: blur(24px) saturate(190%);
      border-bottom: 1px solid rgba(229, 231, 235, 0.8);
      box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.12), inset 0 1px 0 0 rgba(255, 255, 255, 0.9);
      padding: 1.25rem 1.5rem 1.75rem;
      transform: translateY(-130%);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 99;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .mobile-nav-drawer.open {
      transform: translateY(0);
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .mobile-nav-links a {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-primary);
      text-decoration: none;
      padding: 0.6rem 0;
      border-bottom: 1px solid rgba(229, 231, 235, 0.5);
    }

    .mobile-nav-links a.active {
      color: var(--accent-primary);
    }

    .mobile-nav-divider {
      height: 1px;
      background: var(--border-subtle);
    }

    .mobile-nav-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .mobile-nav-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.45);
      backdrop-filter: blur(4px);
      z-index: 98;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }

    .mobile-nav-backdrop.active {
      opacity: 1;
      visibility: visible;
    }

    .currency-toggle-wrapper {
      display: inline-flex;
      align-items: center;
    }
    .currency-toggle-pill {
      display: inline-flex;
      align-items: center;
      background: var(--bg-tertiary, #f1f5f9);
      border: 1px solid var(--border-subtle, rgba(0,0,0,0.1));
      border-radius: 999px;
      padding: 2px;
      gap: 2px;
    }
    .currency-btn {
      background: transparent;
      border: none;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--text-secondary, #64748b);
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }
    .currency-btn:hover {
      color: var(--text-primary, #0f172a);
    }
    .currency-btn.active {
      background: var(--accent-primary, #2563eb);
      color: #ffffff;
      box-shadow: 0 1px 4px rgba(37, 99, 235, 0.25);
    }

    @media (max-width: 768px) {
      .mobile-nav-toggle {
        display: flex;
      }
      .footer-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    }
    @media (max-width: 480px) {
      .footer-grid { grid-template-columns: 1fr; }
      .header-actions #login-btn,
      .header-actions #register-btn {
        display: none !important;
      }
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';

    // Universal Currency Management for Public Site
    function initPublicCurrency() {
      const configuredApiBase = String(import.meta.env.PUBLIC_API_URL || '').replace(/\/$/, '');
      const isLocalHost = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      const apiBase = isLocalHost ? configuredApiBase : '';
      const curr = localStorage.getItem('otpwala_currency') || (navigator.language.toLowerCase().endsWith('-in') ? 'INR' : 'USD');
      const btnInr = document.getElementById('pub-btn-curr-inr');
      const btnUsd = document.getElementById('pub-btn-curr-usd');
      const currencyToggle = document.getElementById('public-currency-toggle');
      const revealCurrencyToggle = () => { if (currencyToggle) currencyToggle.style.visibility = 'visible'; };

      async function saveCurrency(currency: string) {
        try {
          const { data: { session } } = await supabase.auth.getSession();
          await fetch(`${apiBase}/api/user/currency-preference`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', ...(session?.access_token ? { Authorization: `Bearer ${session.access_token}` } : {}) },
            body: JSON.stringify({ currency }),
          });
        } catch {}
      }

      async function loadCurrency() {
        try {
          const localCurrency = localStorage.getItem('otpwala_currency');
          if (localCurrency === 'INR' || localCurrency === 'USD') { revealCurrencyToggle(); return; }
          const { data: { session } } = await supabase.auth.getSession();
          const response = await fetch(`${apiBase}/api/user/currency-preference`, { headers: session?.access_token ? { Authorization: `Bearer ${session.access_token}` } : {} });
          const payload = await response.json();
          const serverCurrency = payload?.data?.currency;
          if (serverCurrency === 'INR' || serverCurrency === 'USD') {
            localStorage.setItem('otpwala_currency', serverCurrency);
            updateBtns(serverCurrency);
            window.dispatchEvent(new CustomEvent('otpwala:currency-change', { detail: { currency: serverCurrency } }));
          }
        } catch {} finally { revealCurrencyToggle(); }
      }

      function updateBtns(c: string) {
        if (!btnInr || !btnUsd) return;
        if (c === 'USD') {
          btnInr.classList.remove('active');
          btnUsd.classList.add('active');
        } else {
          btnUsd.classList.remove('active');
          btnInr.classList.add('active');
        }
      }
      updateBtns(curr);
      if (localStorage.getItem('otpwala_currency') === 'INR' || localStorage.getItem('otpwala_currency') === 'USD') revealCurrencyToggle();

      btnInr?.addEventListener('click', () => {
        localStorage.setItem('otpwala_currency', 'INR');
        updateBtns('INR');
        void saveCurrency('INR');
        window.dispatchEvent(new CustomEvent('otpwala:currency-change', { detail: { currency: 'INR' } }));
      });

      btnUsd?.addEventListener('click', () => {
        localStorage.setItem('otpwala_currency', 'USD');
        updateBtns('USD');
        void saveCurrency('USD');
        window.dispatchEvent(new CustomEvent('otpwala:currency-change', { detail: { currency: 'USD' } }));
      });

      window.addEventListener('otpwala:currency-change', (e: any) => {
        if (e.detail?.currency) updateBtns(e.detail.currency);
      });
      void loadCurrency();
    }
    initPublicCurrency();

    async function syncNavAuth() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session?.user) return;

        let targetUrl = '/dashboard';
        let label = 'Dashboard';

        try {
          const { data: profile } = await supabase
            .from('profiles')
            .select('role')
            .eq('id', session.user.id)
            .single();
          if ((profile?.role === 'admin' || profile?.role === 'superadmin')) {
            targetUrl = '/admin';
            label = 'Admin Panel';
          }
        } catch {}

        // Update header buttons
        const loginBtn = document.getElementById('login-btn');
        const registerBtn = document.getElementById('register-btn');
        const mobileLoginBtn = document.getElementById('mobile-login-btn');
        const mobileRegisterBtn = document.getElementById('mobile-register-btn');
        const heroCta = document.getElementById('hero-cta');

        if (loginBtn) {
          loginBtn.textContent = label;
          loginBtn.setAttribute('href', targetUrl);
          loginBtn.className = 'btn btn-secondary btn-sm';
        }
        if (mobileLoginBtn) {
          mobileLoginBtn.textContent = label;
          mobileLoginBtn.setAttribute('href', targetUrl);
        }

        const handleSignOut = async (e: Event) => {
          e.preventDefault();
          try {
            await supabase.auth.signOut({ scope: 'local' });
          } finally {
            window.location.replace('/auth/login');
          }
        };

        if (registerBtn) {
          registerBtn.textContent = 'Log Out';
          registerBtn.setAttribute('href', '#');
          registerBtn.className = 'btn btn-ghost btn-sm';
          registerBtn.onclick = handleSignOut;
        }
        if (mobileRegisterBtn) {
          mobileRegisterBtn.textContent = 'Log Out';
          mobileRegisterBtn.setAttribute('href', '#');
          mobileRegisterBtn.className = 'btn btn-ghost';
          mobileRegisterBtn.onclick = handleSignOut;
        }

        if (heroCta) {
          heroCta.textContent = `Go to ${label} →`;
          heroCta.setAttribute('href', targetUrl);
        }
      } catch {}
    }

    // Header glass elevation on scroll
    const siteHeader = document.querySelector('.site-header');
    if (siteHeader) {
      const handleScroll = () => {
        if (window.scrollY > 10) {
          siteHeader.classList.add('scrolled');
        } else {
          siteHeader.classList.remove('scrolled');
        }
      };
      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // Mobile nav toggle
    const navToggle = document.getElementById('mobile-nav-toggle');
    const navDrawer = document.getElementById('mobile-nav-drawer');
    const navBackdrop = document.getElementById('mobile-nav-backdrop');

    function toggleMobileNav() {
      const isOpen = navDrawer?.classList.toggle('open');
      navBackdrop?.classList.toggle('active', !!isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    }

    navToggle?.addEventListener('click', toggleMobileNav);
    navBackdrop?.addEventListener('click', toggleMobileNav);

    // Close on drawer link click
    navDrawer?.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        navDrawer.classList.remove('open');
        navBackdrop?.classList.remove('active');
        document.body.style.overflow = '';
      });
    });

    // Run on mount and listen to auth changes
    syncNavAuth();
    supabase.auth.onAuthStateChange((_event, session) => {
      if (session) {
        syncNavAuth();
      }
    });

    // Dynamic Branding Sync
    (function syncBranding() {
      function applyBrand(b) {
        if (!b) return;
        var bName = b.brandName || 'OTPWala';
        var bSep = b.separator || '—';
        var bSlogan = b.slogan || 'Instant Virtual Numbers for SMS Verification';
        if (window.location.pathname === '/' || window.location.pathname === '') {
          document.title = bName + ' ' + bSep + ' ' + bSlogan;
        } else if (document.title) {
          var parts = document.title.split(/ [—|•-] /);
          var prefix = parts[0] ? parts[0].trim() : '';
          if (prefix && prefix !== bName) {
            document.title = prefix + ' ' + bSep + ' ' + bName;
          }
        }
        document.querySelectorAll('[data-brand-name]').forEach(function(el) {
          el.textContent = bName;
        });
        document.querySelectorAll('[data-brand-slogan]').forEach(function(el) {
          el.textContent = bSlogan;
        });
        document.querySelectorAll('[data-brand-separator]').forEach(function(el) {
          el.textContent = bSep;
        });

        if (typeof b.maintenanceMode !== 'undefined') {
          checkMaintenance(b.maintenanceMode);
        }
      }

      function checkMaintenance(isMaint) {
        var overlay = document.getElementById('fullsite-maintenance-overlay');
        if (!overlay) return;
        var path = window.location.pathname;
        if (path.startsWith('/admin') || path === '/auth/login') {
          overlay.style.display = 'none';
          return;
        }
        if (isMaint) {
          try {
            var rawUser = localStorage.getItem('otpwala_user_profile');
            if (rawUser) {
              var profile = JSON.parse(rawUser);
              if (profile && (profile.role === 'admin' || profile.role === 'superadmin')) {
                overlay.style.display = 'none';
                return;
              }
            }
          } catch(e) {}
          overlay.style.display = 'flex';
        } else {
          overlay.style.display = 'none';
        }
      }

      try {
        var cachedMaint = localStorage.getItem('otpwala_maintenance_mode');
        if (cachedMaint === 'true') checkMaintenance(true);
      } catch(e) {}

      try {
        var cached = localStorage.getItem('otpwala_branding');
        if (cached) applyBrand(JSON.parse(cached));
      } catch(e) {}

      const apiUrl = (window as any).__PUBLIC_API_URL__ !== undefined ? (window as any).__PUBLIC_API_URL__ : '';
      fetch(apiUrl + '/api/branding')
        .then(function(res) { return res.json(); })
        .then(function(json) {
          if (json && json.success && json.data) {
            localStorage.setItem('otpwala_branding', JSON.stringify(json.data));
            if (typeof json.data.maintenanceMode !== 'undefined') {
              localStorage.setItem('otpwala_maintenance_mode', String(json.data.maintenanceMode));
            }
            applyBrand(json.data);
          }
        })
        .catch(function() {});
    })();
  </script>

  <!-- Full-Site Maintenance Overlay -->
  <div id="fullsite-maintenance-overlay" style="display: none; position: fixed; inset: 0; z-index: 999999; background: rgba(8, 10, 18, 0.96); backdrop-filter: blur(24px); align-items: center; justify-content: center; padding: 1.5rem; text-align: center;">
    <div style="max-width: 560px; width: 100%; background: linear-gradient(180deg, rgba(26, 32, 53, 0.85) 0%, rgba(13, 17, 28, 0.98) 100%); border: 1px solid rgba(239, 68, 68, 0.35); border-radius: 24px; padding: 3rem 2rem; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 50px rgba(239, 68, 68, 0.15);">
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 0.4rem 1rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 1.75rem;">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: #ef4444; box-shadow: 0 0 10px #ef4444;"></span>
        <span>SYSTEM MAINTENANCE ACTIVE</span>
      </div>
      <div style="width: 72px; height: 72px; border-radius: 20px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.25); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
      </div>
      <h1 style="font-size: 1.85rem; font-weight: 800; color: #ffffff; margin: 0 0 0.85rem 0; font-family: var(--font-display, 'Outfit', sans-serif);">
        Platform Under <span style="color: #f87171;">Maintenance</span>
      </h1>
      <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6; margin: 0 0 2rem 0;">
        <strong style="color: #ffffff;"><span data-brand-name>OTPWala</span></strong> is currently undergoing scheduled platform upgrades. All user balances and active numbers are safe. Services will resume shortly.
      </p>
      <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem;">
        <button onclick="window.location.reload()" class="btn btn-primary" style="padding: 0.75rem 1.5rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.4rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
          <span>Refresh Page</span>
        </button>
        <a href="https://t.me/OTPWalaSupport" target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="padding: 0.75rem 1.5rem; font-weight: 600;">
          Telegram Support
        </a>
      </div>
      <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); padding-top: 1.25rem; font-size: 0.8rem; color: #64748b;">
        Administrator? <a href="/auth/login" style="color: #60a5fa; text-decoration: underline; font-weight: 600;">Access Admin Panel &rarr;</a>
      </div>
    </div>
  </div>
</body>
</html>
