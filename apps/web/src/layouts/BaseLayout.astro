              <circle cx="406" cy="98" r="9" fill="#10b981" />
              <circle cx="406" cy="98" r="4.5" fill="#ffffff" />
            </g>
          </svg>
        </span>
        <span class="logo-text"><span data-brand-name>OTPWala</span></span>
      </a>
      
      <nav class="nav-links hide-mobile" id="main-nav">
