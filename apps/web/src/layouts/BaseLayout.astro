---
import '../styles/global.css';
import { formatPageTitle, DEFAULT_BRANDING } from '../lib/branding';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { 
  title,
  description = 'Browse live OTPWala services, countries, stock, and current virtual-number pricing before purchase.',
  canonical,
  keywords = 'virtual number, sms verification, otp receive, temporary phone number, fake number for otp, whatsapp virtual number, telegram otp, india virtual number, online sms receiver, cheap otp service, otp wala',
  ogType = 'website',
  ogImage = 'https://otpwala.me/og-image.png',
  noindex = false
} = Astro.props;

const formattedTitle = formatPageTitle(title);

// Resolve canonical URL
const siteOrigin = 'https://otpwala.me';
const canonicalURL = canonical || new URL(Astro.url.pathname, siteOrigin).href;
const currentPath = Astro.url.pathname;

// JSON-LD Structured Data
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "OTPWala",
  "url": siteOrigin,
  "logo": `${siteOrigin}/favicon.svg`,
  "sameAs": [
    "https://t.me/OTPWalaSupport"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Support",
    "email": "support@otpwala.me",
    "availableLanguage": ["English", "Hindi"]
  }
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "OTPWala",
  "url": siteOrigin,
  "description": "Instant Virtual Numbers for SMS & OTP Verification",
  "inLanguage": "en"
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "OTPWala",
  "url": siteOrigin,
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "All",
  "inLanguage": "en"
};

const pageName = (title || 'OTPWala').replace(/\s*[—|-]\s*OTPWala.*$/i, '').trim() || 'OTPWala';
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": formattedTitle,
  "description": description,
  "isPartOf": { "@id": `${siteOrigin}/#website` },
  "about": { "@id": `${siteOrigin}/#organization` },
  "inLanguage": "en"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteOrigin}/` },
    ...(currentPath === '/' ? [] : [{ "@type": "ListItem", "position": 2, "name": pageName, "item": canonicalURL }])
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  
  <!-- Primary Meta Tags -->
  <title>{formattedTitle}</title>
  <meta name="title" content={formattedTitle} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="OTPWala" />
  <meta name="theme-color" content="#2563eb" />
  <meta name="application-name" content="OTPWala" />
  <meta name="apple-mobile-web-app-title" content="OTPWala" />

  <!-- Robots / Crawling Directive -->
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )}

  <script is:inline>
    if (window.location.hostname.endsWith('pages.dev')) {
      let meta = document.querySelector('meta[name="robots"]');
      if (meta) {
        meta.setAttribute('content', 'noindex, nofollow, noarchive');
      } else {
        meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex, nofollow, noarchive';
        document.head.appendChild(meta);
      }
    }
    (function() {
      var host = window.location.hostname;
      if (host === 'localhost' || host === '127.0.0.1' || host.startsWith('192.168.') || host.startsWith('10.')) {
        window.__PUBLIC_API_URL__ = 'http://localhost:3001';
      } else {
        window.__PUBLIC_API_URL__ = '';
      }
    })();
  </script>

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Facebook -->
  <meta property="og:site_name" content="OTPWala" />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={formattedTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="OTPWala — Instant Virtual Numbers for SMS Verification" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={formattedTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="OTPWala Virtual Number Service" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="dns-prefetch" href="https://api.iconify.design" />
  <link rel="dns-prefetch" href="https://flagcdn.com" />

  <!-- Favicons & Touch Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
  <link rel="shortcut icon" href="/favicon.ico?v=3" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
  <link rel="manifest" href="/site.webmanifest?v=3" />
  
  <!-- Structured Data: JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify({ ...organizationSchema, "@id": `${siteOrigin}/#organization` })} />
  <script type="application/ld+json" set:html={JSON.stringify({ ...webSiteSchema, "@id": `${siteOrigin}/#website` })} />
  <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Instant Site Branding Pre-Hydration (Zero FOUC) -->
  <script is:inline>
    (function() {
      try {
        var rawB = localStorage.getItem('otpwala_branding');
        if (rawB) {
          var b = JSON.parse(rawB);
          var bName = b.brandName || 'OTPWala';
          var bSep = b.separator || '—';
          var bSlogan = b.slogan || 'Instant Virtual Numbers for SMS Verification';
          
          if (window.location.pathname === '/' || window.location.pathname === '') {
            document.title = bName + ' ' + bSep + ' ' + bSlogan;
          } else {
            var parts = document.title.split(/ [—|•-] /);
            var prefix = parts[0] ? parts[0].trim() : '';
            if (prefix && prefix !== bName) {
              document.title = prefix + ' ' + bSep + ' ' + bName;
            }
          }
        }
      } catch (e) {}
    })();
  </script>

  <!-- Instant Auth Config State Pre-Hydration (Zero FOUC) -->
  <script is:inline>
    (function() {
      try {
        var path = window.location.pathname;
        var cl = document.documentElement.classList;
        if (path === '/auth/register' || path === '/auth/login') cl.add('auth-config-pending');
        var raw = localStorage.getItem('otpwala_auth_config');
        if (raw) {
          var cfg = JSON.parse(raw);
          if (cfg.allowRegistration === false) cl.add('auth-config-no-reg');
          if (cfg.allowEmailSignup === false) cl.add('auth-config-no-email');
          if (cfg.allowGoogleLogin === false) cl.add('auth-config-no-google');
        }
      } catch (e) {}
    })();
  </script>
</head>
