---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

// SEO Structured Data
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://otpwala.me"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "How It Works",
      "item": "https://otpwala.me/how-it-works"
    }
  ]
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Receive SMS OTP Verification on OTPWala",
  "description": "A 3-step guide to ordering a temporary virtual phone number and following its SMS status.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Top Up Wallet via UPI",
      "text": "Submit a wallet top-up using a supported UPI app and use the balance after it is credited.",
      "url": "https://otpwala.me/how-it-works#step-1"
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Select Service and Country",
      "text": "Choose a service and country from the options currently returned by the live catalog.",
      "url": "https://otpwala.me/how-it-works#step-2"
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Wait for the SMS Code",
      "text": "Enter the assigned virtual phone number on your app and follow its live order status. If no OTP arrives, the charge is refunded after cancellation or automatic expiry.",
      "url": "https://otpwala.me/how-it-works#step-3"
    }
  ]
};

const howItWorksFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do I need to install an app or SIM card?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Everything runs seamlessly in your web browser. You do not need physical SIM cards, dongles, or mobile applications."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if the SMS verification code does not arrive?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If a phone number does not receive an OTP, the charge is refunded to your wallet within 5–10 minutes after cancellation or automatic expiry."
      }
    },
    {
      "@type": "Question",
      "name": "How long is a virtual number active for?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each number remains active for a 15 to 20 minute activation window, which is more than enough time to request and receive your OTP code."
      }
    },
    {
      "@type": "Question",
      "name": "Can someone else see my SMS code?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Never. Unlike free public number websites where messages are broadcast publicly, OTPWala numbers are private and private to your account session only."
      }
    }
  ]
};
---

<BaseLayout 
  title="How to Receive SMS Verification Codes — OTPWala"
  description="Learn how OTPWala virtual numbers work: add wallet balance, select a service and country, receive an SMS verification code, and handle eligible cancellations."
  canonical="https://otpwala.me/how-it-works"
  keywords="how to get virtual number, receive otp online, temporary phone number guide, sms verification tutorial, virtual number india upi, auto refund otp"
>
  <!-- SEO Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(howItWorksFaqSchema)} />

  <section class="how-page">
    <div class="container">
      <Breadcrumb current="How It Works" />

      <!-- Hero Section -->
      <div class="how-hero">
        <span class="badge-pill">Simple 3-Step Process</span>
        <h1>How <span class="text-gradient">OTPWala</span> Works</h1>
        <p class="hero-desc">
          Select a service and country from the live catalog, review current stock and pricing, and follow the order status on screen.
          No SIM card or hardware is required.
        </p>
      </div>

      <!-- 3 Steps Timeline Cards -->
      <div class="steps-timeline">
        <!-- Step 1 -->
        <div class="step-box" id="step-1">
          <div class="step-badge">STEP 01</div>
          <div class="step-icon-wrap blue">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
          </div>
          <h2>Top Up Your Wallet</h2>
          <p class="step-summary">
            Submit a wallet top-up via a supported UPI app and use the balance after it is credited.
          </p>
          <ul class="step-highlights">
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Minimum deposit starting from just <strong>₹50</strong></li>
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Review the credited balance in your wallet</li>
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> View wallet transactions from your dashboard</li>
          </ul>
        </div>

        <!-- Step 2 -->
        <div class="step-box" id="step-2">
          <div class="step-badge">STEP 02</div>
          <div class="step-icon-wrap purple">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <h2>Select Service & Country</h2>
          <p class="step-summary">
            Choose from the services and countries currently available on OTPWala.
          </p>
          <ul class="step-highlights">
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Real-time stock and prices displayed upfront</li>
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Live country-specific pricing displayed before purchase</li>
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Number details appear after OTPWala accepts the order</li>
          </ul>
        </div>

        <!-- Step 3 -->
        <div class="step-box" id="step-3">
          <div class="step-badge">STEP 03</div>
          <div class="step-icon-wrap green">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <h2>Receive OTP & Verify</h2>
          <p class="step-summary">
            Enter the allocated number on your app. The verification code appears in your OTPWala dashboard when received.
          </p>
          <ul class="step-highlights">
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> 1-Click copy code button</li>
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Active countdown timer with live status</li>
            <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Refunds when no OTP arrives after cancellation or automatic expiry</li>
          </ul>
        </div>
      </div>

      <!-- Live Interactive Simulator -->
      <div class="simulator-wrapper">
        <div class="sim-header">
          <span class="badge-pill">Interactive Demonstration</span>
          <h2>See the Order Status Flow</h2>
          <p>This illustration shows how a number and received code appear in an active order. Actual delivery time varies.</p>
        </div>

        <div class="sim-card card-glass">
          <div class="sim-phone-header">
            <div class="sim-carrier">
              <span class="dot-online"></span>
              <strong>Live Carrier Connection (USA +1)</strong>
            </div>
            <span class="sim-timer" id="sim-timer">19:48</span>
          </div>

          <div class="sim-content">
            <div class="sim-row">
              <span class="sim-label">Allocated Number:</span>
              <div class="sim-number-box">
                <span class="number-val">+1 (786) 408-9214</span>
                <button class="btn-copy-sm" id="demo-copy-btn">Copy Number</button>
              </div>
            </div>

            <div class="sim-row">
              <span class="sim-label">Target Service:</span>
              <span class="sim-badge-srv">WhatsApp Messenger</span>
            </div>

            <!-- Simulated SMS Message Box -->
            <div class="sim-sms-box" id="sim-sms-box">
              <div class="sms-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-9 8.5 8.5 8.5 0 0 1-4-.99L3 21l1.99-4.99A8.5 8.5 0 1 1 21 11.5z"/></svg></div>
              <div class="sms-body">
                <div class="sms-meta">Incoming SMS from WhatsApp &bull; Just now</div>
                <div class="sms-text">Your WhatsApp verification code is: <strong class="otp-highlight">591-820</strong></div>
              </div>
              <button class="btn-copy-otp" id="demo-copy-otp">Copy 591820</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Auto-Refund Guarantee Details -->
      <div class="refund-section">
        <div class="refund-grid">
          <div class="refund-info">
            <span class="badge-pill" style="background:#f0fdf4; color:#16a34a; border-color:#bbf7d0">Cancellation Process</span>
            <h2>How Cancellation Refunds Work</h2>
            <p>
              Cancellation eligibility and errors are shown directly by OTPWala. Here is the status flow:
            </p>
            <div class="refund-steps">
              <div class="rf-step">
                <div class="rf-num">1</div>
                <div>
                  <h4>15-Minute Countdown</h4>
                  <p>When you order a number, a 15–20 minute countdown starts for code delivery.</p>
                </div>
              </div>
              <div class="rf-step">
                <div class="rf-num">2</div>
                <div>
                  <h4>Provider-Verified Cancellation</h4>
                  <p>You may request cancellation while the number is waiting. The SMS provider decides whether it is allowed; OTPWala marks it cancelled and starts the refund only after the provider confirms cancellation.</p>
                </div>
              </div>
              <div class="rf-step">
                <div class="rf-num">3</div>
                <div>
                  <h4>Refund After Cancellation or Expiry</h4>
                  <p>If no OTP is received, the charge is refunded to your wallet within 5–10 minutes after cancellation or automatic expiry.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="refund-card-visual card-glass">
            <div class="shield-badge"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
            <h3>Cancellation Status You Can Follow</h3>
            <p>OTPWala shows the cancellation result and credits eligible orders after confirmation:</p>
            <ul class="guarantee-list">
              <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Refunds apply when no OTP is received</li>
              <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Cancellation rejection errors are shown directly</li>
              <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Wallet credit appears within 5–10 minutes after cancellation or automatic expiry</li>
              <li><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Telegram support link is available from the website</li>
            </ul>
            <a href="/auth/register" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem;">Create Account →</a>
          </div>
        </div>
      </div>

      <!-- Privacy Comparison -->
      <div class="privacy-compare-section">
        <div class="section-heading">
          <span class="badge-pill">Security & Privacy</span>
          <h2>Why Avoid Free Public Number Sites?</h2>
          <p>Public SMS websites expose your confidential OTP codes and data to the entire world.</p>
        </div>

        <div class="compare-table-wrapper">
          <table class="compare-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th class="danger-header">Free Public SMS Sites</th>
                <th class="success-header">OTPWala Private Numbers</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Privacy & Exclusivity</strong></td>
                <td class="text-danger"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Public inbox — anyone can read your messages</td>
                <td class="text-success"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Order details shown in your authenticated account</td>
              </tr>
              <tr>
                <td><strong>Delivery Speed</strong></td>
                <td class="text-danger"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Slow or congested (minutes to hours)</td>
                <td class="text-success"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Live order status in your dashboard</td>
              </tr>
              <tr>
                <td><strong>Account Safety</strong></td>
                <td class="text-danger"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> High risk of account hijacking or ban</td>
                <td class="text-success"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Temporary numbers supplied by OTPWala</td>
              </tr>
              <tr>
                <td><strong>Country Coverage</strong></td>
                <td class="text-danger"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> Few recycled European/US numbers</td>
                <td class="text-success"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Countries currently available on OTPWala</td>
              </tr>
              <tr>
                <td><strong>Refund Policy</strong></td>
                <td class="text-danger"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg> No support or guarantees</td>
                <td class="text-success"><svg class="inline-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg> Refund if no OTP arrives after cancellation or automatic expiry</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="faq-container">
        <div class="section-heading">
          <span class="badge-pill">Got Questions?</span>
          <h2>Frequently Asked Questions</h2>
        </div>

        <div class="faq-accordion">
          <details class="faq-item" open>
            <summary class="faq-question">Do I need to install an app or SIM card?</summary>
            <div class="faq-answer">
              <p>No. Everything runs seamlessly in your web browser. You do not need physical SIM cards, dongles, or mobile applications.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">What happens if the SMS verification code does not arrive?</summary>
            <div class="faq-answer">
              <p>If a phone number does not receive an OTP, the charge is refunded to your wallet within 5–10 minutes after cancellation or automatic expiry.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">How long is a virtual number active for?</summary>
            <div class="faq-answer">
              <p>Each number remains active for a 15 to 20 minute activation window, which is more than enough time to request and receive your OTP code.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">Can someone else see my SMS code?</summary>
            <div class="faq-answer">
              <p>Never. Unlike free public number websites where messages are broadcast publicly, OTPWala numbers are private to your account session only.</p>
            </div>
          </details>
        </div>
      </div>

      <!-- Bottom Conversion -->
      <div class="bottom-cta card-glass">
        <h2>Start With the Live Catalog</h2>
        <p>Create an account to view current service, country, stock, and pricing data.</p>
        <div class="cta-actions">
          <a href="/auth/register" class="btn btn-primary btn-lg">Create Free Account</a>
          <a href="/services" class="btn btn-secondary btn-lg">Browse Supported Services</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .how-page {
    padding: 2rem 0 5rem;
  }

  .breadcrumb-nav { margin-bottom: 1.5rem; }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted, #64748b);
  }
  .breadcrumb-list a {
    color: var(--text-secondary, #475569);
    text-decoration: none;
  }
  .breadcrumb-list a:hover { color: var(--accent-primary, #2563eb); }
  .breadcrumb-list li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: #cbd5e1;
  }

  .how-hero {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }
  .badge-pill {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
    border: 1px solid #bfdbfe;
  }
  .how-hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }
  .hero-desc {
    font-size: 1.1rem;
    color: var(--text-secondary, #475569);
    line-height: 1.6;
  }

  /* Steps Timeline */
  .steps-timeline {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 5rem;
  }
  .step-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 2.25rem 1.75rem;
    position: relative;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .step-box:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(37, 99, 235, 0.08);
  }
  .step-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    color: #2563eb;
    background: #eff6ff;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }
  .step-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
  .step-icon-wrap.blue { background: #eff6ff; color: #2563eb; }
  .step-icon-wrap.purple { background: #faf5ff; color: #9333ea; }
  .step-icon-wrap.green { background: #f0fdf4; color: #16a34a; }
  .step-box h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.6rem;
  }
  .step-summary {
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }
  .step-highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid #f1f5f9;
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .step-highlights li {
    font-size: 0.82rem;
    color: #64748b;
  }

  /* Live Simulator */
  .simulator-wrapper {
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 3.5rem 2rem;
    margin-bottom: 5rem;
    text-align: center;
  }
  .sim-header {
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }
  .sim-header h2 {
    font-size: 2rem;
    font-weight: 800;
    margin: 0.5rem 0;
  }
  .sim-header p {
    color: #64748b;
    font-size: 0.95rem;
  }
  .sim-card {
    max-width: 580px;
    margin: 0 auto;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 2rem;
    text-align: left;
