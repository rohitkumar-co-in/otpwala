  // Simple interactive copy buttons in demonstration box
  const copyBtn = document.getElementById('demo-copy-btn');
  const copyOtp = document.getElementById('demo-copy-otp');

  copyBtn?.addEventListener('click', () => {
    navigator.clipboard?.writeText('+17864089214');
    copyBtn.textContent = 'Copied!';
    setTimeout(() => { copyBtn.textContent = 'Copy Number'; }, 2000);
  });

  copyOtp?.addEventListener('click', () => {
    navigator.clipboard?.writeText('591820');
    copyOtp.textContent = 'Copied!';
    setTimeout(() => { copyOtp.textContent = 'Copy 591820'; }, 2000);
  });
</script>
