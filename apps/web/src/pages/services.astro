<script>
  const searchInput = document.getElementById('service-search');
  const servicesGrid = document.getElementById('services-grid');
  const popularServicesGrid = document.getElementById('popular-services-grid');
  const serviceAlpha = document.getElementById('service-alpha');
  const emptyState = document.getElementById('services-empty');
  const serviceCount = document.getElementById('service-count');
  const loadMoreButton = document.getElementById('load-more-services');
  let loadedServices = [...document.querySelectorAll('#services-grid .service-directory-item')].map((card) => ({
    name: card.querySelector('.service-directory-name')?.textContent || '',
    displayName: card.dataset.displayName || card.querySelector('.service-directory-name')?.textContent || '',
    code: card.getAttribute('data-code') || '',
    iconUrl: card.querySelector('img')?.getAttribute('src') || 'https://tiger-sms.com/img/service/unknown.svg',
    isFeatured: false,
  }));
  let alphaFilter = '';

  function renderServiceCards() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    const matches = loadedServices.filter((service) => {
      const name = String(service.name || '').toLowerCase();
      if (alphaFilter === '0-9') return /^\d/.test(name);
      if (alphaFilter === '#') return !/[a-z0-9]/i.test(name[0] || '');
      return !query || (alphaFilter ? name.startsWith(alphaFilter.toLowerCase()) : name.includes(query));
    });
    const visibleServices = matches.sort((a, b) => String(a.name || '').localeCompare(String(b.name || '')));
    if (serviceCount) serviceCount.textContent = String(matches.length);
    if (loadMoreButton) loadMoreButton.hidden = true;
    const groups = new Map();
    visibleServices.forEach((service) => {
      const first = (String(service.name || '#').trim()[0] || '#').toUpperCase();
      const key = /\d/.test(first) ? '0-9' : /[A-Z]/.test(first) ? first : '#';
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)?.push(service);
    });
    const sections = [...groups.entries()].sort(([a], [b]) => {
      const order = (key) => key === '0-9' ? 0 : key === '#' ? 27 : key.charCodeAt(0) - 64;
      return order(a) - order(b);
    }).map(([key, group]) => {
      const section = document.createElement('section');
      section.className = 'directory-group';
      section.id = `svc-${key}`;
      const heading = document.createElement('h3');
      heading.className = 'directory-group-heading';
      heading.innerHTML = `<span>${key}</span><small>${group.length}</small>`;
      const grid = document.createElement('div');
      grid.className = 'directory-grid';
      grid.append(...group.map(createServiceCard));
      section.append(heading, grid);
      return section;
    });
    servicesGrid?.replaceChildren(...sections);
    if (emptyState) emptyState.hidden = matches.length !== 0;
  }

  function renderServiceAlphabet() {
    serviceAlpha?.replaceChildren();
    if (!serviceAlpha) return;
    const allButton = document.createElement('button');
    allButton.textContent = 'All';
  allButton.className = !alphaFilter && !searchInput.value ? 'active' : '';
    allButton.onclick = () => { alphaFilter = ''; searchInput.value = ''; renderServiceCards(); renderServiceAlphabet(); };
    serviceAlpha.append(allButton);
    ['0-9', ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split(''), '#'].forEach((letter) => {
      const button = document.createElement('button');
      button.textContent = letter;
      button.className = alphaFilter === letter ? 'active' : '';
      button.onclick = () => { alphaFilter = letter; searchInput.value = letter === '0-9' ? '' : letter; renderServiceCards(); renderServiceAlphabet(); };
      serviceAlpha.append(button);
    });
  }

  function createServiceCard(service) {
    const card = document.createElement('a');
    card.className = 'service-directory-item';
    card.href = `/dashboard/buy?service=${encodeURIComponent(String(service.code || ''))}`;
    card.dataset.code = String(service.code || '');
    card.dataset.name = String(service.name || '').toLowerCase();

    const icon = document.createElement('img');
    icon.className = 'service-row-icon';
    icon.src = String(service.iconUrl || 'https://tiger-sms.com/img/service/unknown.svg');
    icon.alt = String(service.name || 'Service');
    icon.width = 32;
    icon.height = 32;
    icon.loading = 'lazy';
    icon.addEventListener('error', () => {
      if (!icon.src.endsWith('/unknown.svg')) icon.src = 'https://tiger-sms.com/img/service/unknown.svg';
    });
    const title = document.createElement('span');
    title.className = 'service-directory-name';
    title.textContent = String(service.displayName || service.name || service.code || 'Service');
    card.append(icon, title);
    return card;
  }

  searchInput?.addEventListener('input', () => { alphaFilter = ''; renderServiceCards(); renderServiceAlphabet(); });
  renderServiceAlphabet();
  renderServiceCards();

</script>
