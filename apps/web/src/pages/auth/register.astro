---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Create Account — OTPWala" 
  description="Create your OTPWala account to browse live virtual-number availability for SMS verification."
  canonical="https://otpwala.me/auth/register"
>
  <section class="auth-page">
    <div class="auth-container">
      <div class="auth-card card-glass">

        <!-- STEP 1: Email Entry -->
        <div id="step-email">
          <div class="auth-header">
            <h1>Create Account</h1>
            <p class="text-secondary">Join OTPWala and get instant virtual numbers for SMS verification</p>
          </div>

          <div id="registration-closed-notice" style="display: none; background: var(--warning-bg); border: 1px solid var(--warning-border); padding: 1.25rem; border-radius: var(--radius-md); text-align: center; margin-bottom: 1.5rem;">
            <strong style="display: block; font-size: 1rem; color: var(--warning); margin-bottom: 0.35rem;">Registrations Temporarily Closed</strong>
            <span style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4; display: block;">New user registrations are currently paused. If you already have an account, please log in.</span>
            <a href="/auth/login" class="btn btn-primary" style="display: inline-block; margin-top: 1rem; font-size: 0.88rem; padding: 0.5rem 1.25rem;">Go to Login</a>
          </div>

          <div id="email-signup-disabled-notice" style="display: none; background: #eff6ff; border: 1px solid #bfdbfe; padding: 1rem; border-radius: var(--radius-md); text-align: center; margin-bottom: 1.25rem;">
            <span style="font-size: 0.85rem; color: #1e40af; line-height: 1.4; display: block;">Standard email registration is currently paused. Please use Google to create an account.</span>
          </div>

          <div id="google-signup-wrapper">
            <button class="btn btn-secondary" style="width: 100%; margin-bottom: 1.5rem;" id="google-signup-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              Sign up with Google
            </button>
            <div class="auth-divider"><span>or</span></div>
          </div>

          <form id="email-form">
            <div class="input-group" style="margin-bottom: 1rem;">
              <label for="name">Full Name</label>
              <input type="text" id="name" class="input" placeholder="John Doe" required autocomplete="name" />
            </div>
            <div class="input-group" style="margin-bottom: 1rem;">
              <label for="email">Email Address</label>
              <input type="email" id="email" class="input" placeholder="you@example.com" required autocomplete="email" />
            </div>
            <div class="input-group" style="margin-bottom: 0.5rem;">
              <label for="referral-code">Referral Code <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: normal;">(Optional)</span></label>
              <input type="text" id="referral-code" class="input" placeholder="e.g. REF12345" autocomplete="off" style="text-transform: uppercase;" />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem;" id="email-submit-btn">
              Continue &rarr;
            </button>
          </form>
          <div id="step1-error" class="auth-error" style="display: none;"></div>
          <div class="auth-footer" style="margin-top: 1.5rem; text-align: center; font-size: 0.9rem;">
            <p class="text-secondary">Already have an account? <a href="/auth/login">Log in</a></p>
          </div>
        </div>

        <!-- STEP 2: OTP Verification -->
        <div id="step-otp" style="display: none;">
          <div class="verification-hero">
            <div class="mail-badge-icon">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <div class="check-floating-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
            </div>
            <h2 class="verification-title">Check Your Email</h2>
            <p class="verification-desc">We sent a 6-digit verification code to:</p>
            <div class="email-pill-box">
              <span id="otp-email-display">user@example.com</span>
            </div>
          </div>

          <form id="otp-form" style="margin-top: 1.5rem;">
            <div class="input-group" style="margin-bottom: 1rem;">
              <label for="otp-input">Verification Code</label>
              <input
                type="text"
                id="otp-input"
                class="input otp-input"
                placeholder="000000"
                maxlength="6"
                inputmode="numeric"
                autocomplete="one-time-code"
                required
              />
              <p style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.4rem;">Enter the 6-digit code from your email. Check spam if not found.</p>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;" id="otp-submit-btn">
              Verify Code
            </button>
          </form>
          <div id="step2-error" class="auth-error" style="display: none;"></div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 1.25rem; flex-wrap: wrap; gap: 0.5rem;">
            <button type="button" id="resend-otp-btn" class="link-btn">Resend code</button>
            <button type="button" id="back-to-email-btn" class="link-btn">&larr; Change email</button>
          </div>
          <div id="resend-otp-feedback" style="display: none; font-size: 0.83rem; margin-top: 0.5rem; text-align: center;"></div>
        </div>

        <!-- STEP 3: Set Password -->
        <div id="step-password" style="display: none;">
          <div class="auth-header">
            <div style="width: 56px; height: 56px; margin: 0 auto 1rem; border-radius: 50%; background: linear-gradient(135deg, rgba(16,185,129,0.15), rgba(5,150,105,0.15)); border: 1px solid rgba(16,185,129,0.3); display: flex; align-items: center; justify-content: center;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
            </div>
            <h2 style="font-size: 1.4rem; margin: 0 0 0.25rem;">Email Verified!</h2>
            <p class="text-secondary" style="font-size: 0.88rem; margin: 0;">Now set a secure password for your account</p>
          </div>
          <form id="password-form">
            <div class="input-group" style="margin-bottom: 1rem;">
              <label for="new-password">Password</label>
              <div style="position: relative;">
                <input type="password" id="new-password" class="input" placeholder="Min 8 characters" required minlength="8" style="padding-right: 2.75rem;" />
                <button type="button" class="toggle-pw-btn" data-target="new-password" title="Show/hide password">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <div class="password-strength" style="margin-top: 0.5rem;">
                <div class="strength-bar"><div class="strength-fill" id="strength-fill"></div></div>
                <span class="strength-text" id="strength-text">Password strength</span>
              </div>
            </div>
            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="confirm-password">Confirm Password</label>
              <div style="position: relative;">
                <input type="password" id="confirm-password" class="input" placeholder="Re-enter your password" required minlength="8" style="padding-right: 2.75rem;" />
                <button type="button" class="toggle-pw-btn" data-target="confirm-password" title="Show/hide password">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <p id="pw-match-hint" style="display: none; font-size: 0.78rem; margin-top: 0.35rem;"></p>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;" id="pw-submit-btn">
              Create Account &amp; Sign In
            </button>
          </form>
          <div id="step3-error" class="auth-error" style="display: none;"></div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page { display: flex; align-items: center; justify-content: center; min-height: calc(100vh - var(--header-height)); padding: var(--space-2xl) var(--space-md); }
  .auth-container { width: 100%; max-width: 440px; }
  .auth-card { padding: var(--space-2xl); position: relative; overflow: hidden; }
  .auth-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--accent-gradient); }
  .auth-header { text-align: center; margin-bottom: var(--space-2xl); }
  .auth-header h1 { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .auth-divider { display: flex; align-items: center; gap: var(--space-md); margin-bottom: 1.5rem; color: var(--text-muted); font-size: 0.85rem; }
  .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--border-subtle); }
  .password-strength { display: flex; align-items: center; gap: var(--space-sm); }
  .strength-bar { flex: 1; height: 4px; background: var(--bg-glass-strong); border-radius: var(--radius-full); overflow: hidden; }
  .strength-fill { height: 100%; width: 0%; border-radius: var(--radius-full); transition: all var(--transition-base); background: var(--error); }
  .strength-text { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; }
  .auth-error { margin-top: var(--space-md); padding: 0.75rem; border-radius: var(--radius-md); background: var(--error-bg); border: 1px solid var(--error-border); color: var(--error); font-size: 0.85rem; text-align: center; }
  .otp-input { font-size: 1.8rem; letter-spacing: 0.5rem; text-align: center; font-weight: 700; font-family: var(--font-mono, monospace); height: 64px; }
  .toggle-pw-btn { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); display: flex; align-items: center; padding: 0.25rem; transition: color var(--transition-fast); }
  .toggle-pw-btn:hover { color: var(--text-primary); }
  .verification-hero { text-align: center; margin-bottom: 0; }
  .mail-badge-icon { position: relative; width: 68px; height: 68px; margin: 0.5rem auto 1.25rem; border-radius: 50%; background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(168,85,247,0.15)); border: 1px solid rgba(99,102,241,0.3); box-shadow: 0 0 24px rgba(99,102,241,0.2); display: flex; align-items: center; justify-content: center; color: var(--accent-primary, #6366f1); }
  .check-floating-badge { position: absolute; bottom: -2px; right: -2px; width: 22px; height: 22px; border-radius: 50%; background: #10b981; color: #fff; display: flex; align-items: center; justify-content: center; border: 2px solid var(--bg-surface, #1e293b); box-shadow: 0 2px 6px rgba(16,185,129,0.4); }
  .verification-title { font-size: 1.4rem; font-weight: 700; margin: 0 0 0.4rem; color: var(--text-primary); }
  .verification-desc { font-size: 0.88rem; color: var(--text-secondary); margin: 0 0 0.75rem; }
  .email-pill-box { display: inline-block; max-width: 100%; padding: 0.45rem 1rem; background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25); border-radius: 9999px; color: var(--accent-primary, #6366f1); font-weight: 600; font-size: 0.92rem; word-break: break-all; }
  .link-btn { background: none; border: none; color: var(--text-muted); font-size: 0.85rem; cursor: pointer; text-decoration: underline; padding: 0.25rem; transition: color var(--transition-fast); }
  .link-btn:hover { color: var(--text-primary); }
  @media (max-width: 480px) {
    .auth-page { padding: 1.5rem 1rem; }
    .auth-card { padding: 1.75rem 1.25rem; border-radius: var(--radius-md); }
    .otp-input { font-size: 1.4rem; letter-spacing: 0.35rem; height: 56px; }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { validateAllowedEmail } from '../../lib/emailValidation';
  import { getAuthConfig } from '../../lib/api';

  let currentEmail = '';
  let currentName = '';
  let currentReferralCode = '';
  let resendCooldown = 0;
  let resendInterval = null;
  let pendingPasswordSetup = false; // Blocks auto-redirect while user is setting password
  let authConfig = { allowEmailSignup: true, allowGoogleLogin: true, allowRegistration: true };

  const stepEmail    = document.getElementById('step-email');
  const stepOtp      = document.getElementById('step-otp');
  const stepPassword = document.getElementById('step-password');
  const emailForm    = document.getElementById('email-form');
  const otpForm      = document.getElementById('otp-form');
  const passwordForm = document.getElementById('password-form');
  const emailInput   = document.getElementById('email');
  const nameInput    = document.getElementById('name');
  const refCodeInput = document.getElementById('referral-code');
  const otpInput     = document.getElementById('otp-input');
  const newPwInput   = document.getElementById('new-password');
  const confirmPwInput = document.getElementById('confirm-password');
  const emailSubmitBtn = document.getElementById('email-submit-btn');
  const otpSubmitBtn   = document.getElementById('otp-submit-btn');
  const pwSubmitBtn    = document.getElementById('pw-submit-btn');
  const step1Error = document.getElementById('step1-error');
  const step2Error = document.getElementById('step2-error');
  const step3Error = document.getElementById('step3-error');
  const otpEmailDisplay  = document.getElementById('otp-email-display');
  const resendOtpBtn     = document.getElementById('resend-otp-btn');
  const resendFeedback   = document.getElementById('resend-otp-feedback');
  const backToEmailBtn   = document.getElementById('back-to-email-btn');
  const strengthFill     = document.getElementById('strength-fill');
  const strengthText     = document.getElementById('strength-text');
  const pwMatchHint      = document.getElementById('pw-match-hint');
  const googleBtn        = document.getElementById('google-signup-btn');
  const googleWrapper    = document.getElementById('google-signup-wrapper');
  const regClosedNotice  = document.getElementById('registration-closed-notice');
  const emailDisabledNotice = document.getElementById('email-signup-disabled-notice');

  function showErr(el, msg) { el.innerHTML = msg; el.style.display = 'block'; }
  function hideErr(el) { el.style.display = 'none'; el.textContent = ''; }
  function showStep(step) {
    stepEmail.style.display    = step === 'email'    ? 'block' : 'none';
    stepOtp.style.display      = step === 'otp'      ? 'block' : 'none';
    stepPassword.style.display = step === 'password' ? 'block' : 'none';
  }

  async function checkSessionAndRedirect() {
    if (pendingPasswordSetup) return; // Don't redirect while user is setting up password
    const { data: { session } } = await supabase.auth.getSession();
    if (session && session.user) {
      const card = document.querySelector('.auth-card');
      if (card) card.innerHTML = '<div style="text-align:center;padding:2rem 1rem;"><div class="spinner spinner-lg" style="margin:0 auto 1.25rem;"></div><h3 style="margin:0 0 0.5rem;font-size:1.25rem;font-weight:700;">Account Ready! 🎉</h3><p style="color:var(--text-secondary);font-size:0.9rem;margin:0;">Taking you to your dashboard…</p></div>';
      try {
        const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single();
        if (profile && profile.role === 'admin') { window.location.href = '/admin'; return; }
      } catch(e) {}
      window.location.href = '/dashboard';
    }
  }
  checkSessionAndRedirect();
  supabase.auth.onAuthStateChange(function(_event, session) {
    if (pendingPasswordSetup) return; // Suppress redirect — user is setting up password
    if (session && session.user) checkSessionAndRedirect();
  });

  try {
    const urlParams = new URLSearchParams(window.location.search);
    const refParam = urlParams.get('ref') || urlParams.get('referral');
    if (refParam) {
      const cleanRef = refParam.trim().toUpperCase();
      localStorage.setItem('otpwala_ref_code', cleanRef);
      if (refCodeInput) refCodeInput.value = cleanRef;
    } else {
      const savedRef = localStorage.getItem('otpwala_ref_code');
      if (savedRef && refCodeInput) refCodeInput.value = savedRef;
    }
  } catch(e) {}

  (async function() {
    try {
      const res = await getAuthConfig();
      if (res) authConfig = res;
    } catch(e) {}
    if (!authConfig.allowRegistration) {
      regClosedNotice.style.display = 'block';
      googleWrapper.style.display = 'none';
      emailForm.style.display = 'none';
      return;
    }
    if (!authConfig.allowGoogleLogin) googleWrapper.style.display = 'none';
    if (!authConfig.allowEmailSignup) { emailDisabledNotice.style.display = 'block'; emailForm.style.display = 'none'; }
  })();

  emailForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    hideErr(step1Error);
    if (!authConfig.allowRegistration) { showErr(step1Error, 'Registrations are currently closed by administrator.'); return; }
    if (!authConfig.allowEmailSignup)  { showErr(step1Error, 'Standard email registration is currently paused.'); return; }

    const rawEmail = emailInput.value.trim();
    const name = nameInput.value.trim();
    const refCode = (refCodeInput ? refCodeInput.value : '').trim().toUpperCase();

    const emailVal = validateAllowedEmail(rawEmail);
    if (!emailVal.valid) { showErr(step1Error, emailVal.error || 'Please enter a valid email address.'); return; }
    const cleanEmail = emailVal.cleanedEmail || rawEmail;
    if (refCode) { try { localStorage.setItem('otpwala_ref_code', refCode); } catch(e) {} }

    emailSubmitBtn.disabled = true;
    emailSubmitBtn.textContent = 'Sending code...';
    try {
      const apiUrl = (window.__PUBLIC_API_URL__ !== undefined) ? window.__PUBLIC_API_URL__ : (import.meta.env.PUBLIC_API_URL || '');
      try {
        const checkRes = await fetch(apiUrl + '/api/auth/check-email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: cleanEmail }) });
        if (checkRes.ok) {
          const checkData = await checkRes.json();
          if (checkData && checkData.exists) {
            showErr(step1Error, 'An account with this email already exists. <a href="/auth/login" style="color:var(--accent-primary);text-decoration:underline;font-weight:600;">Log in here</a> or <a href="/auth/forgot-password" style="color:var(--accent-primary);text-decoration:underline;">reset password</a>.');
            return;
          }
        }
      } catch(e) {}

      const { error } = await supabase.auth.signInWithOtp({
        email: cleanEmail,
        options: { shouldCreateUser: true, data: { full_name: name, referral_code: refCode || null } },
      });
      if (error) { showErr(step1Error, error.message || 'Failed to send verification code.'); return; }

      currentEmail = cleanEmail;
      currentName = name;
      currentReferralCode = refCode;
      otpEmailDisplay.textContent = cleanEmail;
      showStep('otp');
      setTimeout(function() { otpInput.focus(); }, 100);
    } catch(err) {
      showErr(step1Error, err.message || 'Failed to send verification code.');
    } finally {
      emailSubmitBtn.disabled = false;
      emailSubmitBtn.textContent = 'Continue';
    }
  });

  otpForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    hideErr(step2Error);
    const token = otpInput.value.trim().replace(/\D/g, '');
    if (token.length !== 6) { showErr(step2Error, 'Please enter the full 6-digit code.'); return; }
    otpSubmitBtn.disabled = true;
    otpSubmitBtn.textContent = 'Verifying...';
    // Set flag BEFORE verifyOtp so the auth state change handler doesn't redirect
    pendingPasswordSetup = true;
    try {
      const { error } = await supabase.auth.verifyOtp({ email: currentEmail, token: token, type: 'email' });
      if (error) {
        pendingPasswordSetup = false; // Reset on error so normal redirect behaviour resumes
        showErr(step2Error, error.message || 'Invalid or expired code. Please try again.');
        return;
      }
      showStep('password');
      setTimeout(function() { newPwInput.focus(); }, 100);
    } catch(err) {
      showErr(step2Error, err.message || 'Verification failed. Please try again.');
    } finally {
      otpSubmitBtn.disabled = false;
      otpSubmitBtn.textContent = 'Verify Code';
    }
  });

  async function sendOtp() {
    const { error } = await supabase.auth.signInWithOtp({
      email: currentEmail,
      options: { shouldCreateUser: true, data: { full_name: currentName, referral_code: currentReferralCode || null } },
    });
    return error;
  }

  resendOtpBtn.addEventListener('click', async function() {
    if (resendCooldown > 0 || !currentEmail) return;
    resendOtpBtn.disabled = true;
    resendFeedback.style.display = 'none';
    resendOtpBtn.textContent = 'Sending...';
    const error = await sendOtp();
    resendFeedback.textContent = error ? (error.message || 'Failed to resend code.') : 'New code sent! Check your inbox.';
    resendFeedback.style.color = error ? 'var(--error)' : 'var(--success)';
    resendFeedback.style.display = 'block';
    resendCooldown = 60;
    resendOtpBtn.textContent = 'Resend in ' + resendCooldown + 's';
    if (resendInterval) clearInterval(resendInterval);
    resendInterval = setInterval(function() {
      resendCooldown--;
      if (resendCooldown <= 0) { clearInterval(resendInterval); resendOtpBtn.disabled = false; resendOtpBtn.textContent = 'Resend code'; }
      else resendOtpBtn.textContent = 'Resend in ' + resendCooldown + 's';
    }, 1000);
  });

  backToEmailBtn.addEventListener('click', function() {
    hideErr(step2Error);
    otpInput.value = '';
    showStep('email');
    setTimeout(function() { emailInput.focus(); }, 100);
  });

  newPwInput.addEventListener('input', function() {
    const val = newPwInput.value;
    let score = 0;
    if (val.length >= 8) score++;
    if (val.length >= 12) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    strengthFill.style.width = (score / 5 * 100) + '%';
    if (score <= 1) { strengthFill.style.background = 'var(--error)'; strengthText.textContent = 'Weak'; }
    else if (score <= 3) { strengthFill.style.background = 'var(--warning)'; strengthText.textContent = 'Medium'; }
    else { strengthFill.style.background = 'var(--success)'; strengthText.textContent = 'Strong'; }
    checkPwMatch();
  });
  confirmPwInput.addEventListener('input', checkPwMatch);
  function checkPwMatch() {
    const pw = newPwInput.value, c = confirmPwInput.value;
    if (!c) { pwMatchHint.style.display = 'none'; return; }
    pwMatchHint.textContent = pw === c ? 'Passwords match' : 'Passwords do not match';
    pwMatchHint.style.color = pw === c ? 'var(--success)' : 'var(--error)';
    pwMatchHint.style.display = 'block';
  }

  passwordForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    hideErr(step3Error);
    const pw = newPwInput.value, confirmPw = confirmPwInput.value;
    if (pw.length < 8) { showErr(step3Error, 'Password must be at least 8 characters.'); return; }
    if (pw !== confirmPw) { showErr(step3Error, 'Passwords do not match. Please re-enter.'); return; }
    pwSubmitBtn.disabled = true;
    pwSubmitBtn.textContent = 'Creating account...';
    try {
      const { error } = await supabase.auth.updateUser({ password: pw, data: { full_name: currentName, referral_code: currentReferralCode || null } });
      if (error) {
        showErr(step3Error, error.message || 'Failed to set password.');
        return;
      }
      if (currentReferralCode) { try { localStorage.setItem('otpwala_ref_code', currentReferralCode); } catch(ex) {} }
      // Password set — allow normal redirect
      pendingPasswordSetup = false;
      const { data: { session } } = await supabase.auth.getSession();
      if (session && session.user) {
        try {
          const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single();
          if (profile && profile.role === 'admin') { window.location.href = '/admin'; return; }
        } catch(ex) {}
      }
      window.location.href = '/dashboard';
    } catch(err) {
      pendingPasswordSetup = false;
      showErr(step3Error, err.message || 'Account creation failed.');
    } finally {
      pwSubmitBtn.disabled = false;
      pwSubmitBtn.textContent = 'Create Account & Sign In';
    }
  });

  document.querySelectorAll('.toggle-pw-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const input = document.getElementById(btn.dataset.target);
      input.type = input.type === 'password' ? 'text' : 'password';
    });
  });

  if (googleBtn) {
    googleBtn.addEventListener('click', async function() {
      if (!authConfig.allowRegistration || !authConfig.allowGoogleLogin) { showErr(step1Error, 'Google sign up is currently disabled.'); return; }
      try {
        await supabase.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: window.location.origin + '/dashboard' } });
      } catch(err) { showErr(step1Error, err.message || 'Google sign up failed'); }
    });
  }

  otpInput.addEventListener('input', function() {
    otpInput.value = otpInput.value.replace(/\D/g, '').slice(0, 6);
  });
</script>
