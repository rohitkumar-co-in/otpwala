---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Create Account — OTPWala" 
  description="Create your free OTPWala account to get instant virtual numbers for SMS verification."
  canonical="https://otpwala.me/auth/register"
>
  <section class="auth-page">
    <div class="auth-container">
      <div class="auth-card card-glass">
        <div class="auth-header" id="register-header">
          <h1>Create Account</h1>
          <p class="text-secondary">Join OTPWala and get instant virtual numbers</p>
        </div>

        <div id="register-form-root">
          <div id="registration-closed-notice" style="display: none; background: var(--warning-bg); border: 1px solid var(--warning-border); padding: 1.25rem; border-radius: var(--radius-md); text-align: center; margin-bottom: 1.5rem;">
            <strong style="display: block; font-size: 1rem; color: var(--warning); margin-bottom: 0.35rem;">Registrations Temporarily Closed</strong>
            <span style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4; display: block;">New user registrations are currently paused by administrator. If you already have an account, please log in.</span>
            <a href="/auth/login" class="btn btn-primary" style="display: inline-block; margin-top: 1rem; font-size: 0.88rem; padding: 0.5rem 1.25rem;">Go to Login</a>
          </div>

          <div id="email-signup-disabled-notice" style="display: none; background: #eff6ff; border: 1px solid #bfdbfe; padding: 1rem; border-radius: var(--radius-md); text-align: center; margin-bottom: 1.25rem;">
            <span style="font-size: 0.85rem; color: #1e40af; line-height: 1.4; display: block;">Standard email registration is currently paused. Please use Google to create an account.</span>
          </div>

          <!-- Google Signup -->
          <div id="google-signup-wrapper">
            <button class="btn btn-secondary" style="width: 100%; margin-bottom: 1.5rem;" id="google-signup-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              Sign up with Google
            </button>

            <div class="auth-divider" id="google-divider">
              <span>or</span>
            </div>
          </div>

          <form id="register-form">
            <div class="input-group" style="margin-bottom: 1rem;">
              <label for="name">Full Name</label>
              <input type="text" id="name" class="input" placeholder="John Doe" required />
            </div>
            <div class="input-group" style="margin-bottom: 1rem;">
              <label for="email">Email</label>
              <input type="email" id="email" class="input" placeholder="you@example.com" required />
            </div>
            <div class="input-group" style="margin-bottom: 0.5rem;">
              <label for="password">Password</label>
              <input type="password" id="password" class="input" placeholder="Min 8 characters" required minlength="8" />
            </div>
            <div class="password-strength" id="password-strength">
              <div class="strength-bar"><div class="strength-fill" id="strength-fill"></div></div>
              <span class="strength-text" id="strength-text">Password strength</span>
            </div>
            <div class="input-group" style="margin-top: 1rem; margin-bottom: 0.5rem;">
              <label for="referral-code">Referral Code <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: normal;">(Optional)</span></label>
              <input type="text" id="referral-code" class="input" placeholder="e.g. REF12345" autocomplete="off" style="text-transform: uppercase;" />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1.5rem;" id="register-submit-btn">
              Create Account
            </button>
          </form>

          <div id="register-error" class="auth-error" style="display: none;"></div>
          <div id="register-success" class="auth-success" style="display: none;"></div>
        </div>

        <!-- Check Email Verification Prompt Card -->
        <div id="check-email-card" style="display: none;">
          <div class="verification-hero">
            <div class="mail-badge-icon">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <div class="check-floating-badge">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
            </div>
            <h2 class="verification-title">Check Your Email</h2>
            <p class="verification-desc">We've sent a verification link to:</p>
            <div class="email-pill-box">
              <span id="registered-email-pill">user@example.com</span>
            </div>
          </div>

          <div class="verification-info-card">
            <div class="info-item">
              <span class="info-bullet">1</span>
              <p>Click the confirmation link inside the email to verify and activate your OTPWala account.</p>
            </div>
            <div class="info-item">
              <span class="info-bullet">2</span>
              <p>Didn't see it? Check your <strong>Spam</strong> or <strong>Promotions</strong> folder. Emails typically arrive within 30 seconds.</p>
            </div>
          </div>

          <div class="verification-actions">
            <a href="/auth/login" class="btn btn-primary" style="width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; text-decoration: none;">
              <span>Go to Login</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>

            <button type="button" id="resend-verification-btn" class="btn btn-secondary" style="width: 100%; margin-top: 0.75rem;">
              Resend Verification Email
            </button>
            <div id="resend-feedback" style="display: none; font-size: 0.85rem; margin-top: 0.5rem; text-align: center;"></div>
          </div>

          <div style="text-align: center; margin-top: 1.5rem;">
            <button type="button" id="change-email-btn" class="link-btn">
              Entered the wrong email? Register again
            </button>
          </div>
        </div>

        <div class="auth-footer" id="register-footer">
          <p class="text-secondary">Already have an account? <a href="/auth/login">Log in</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height));
    padding: var(--space-2xl) var(--space-md);
  }

  .auth-container {
    width: 100%;
    max-width: 440px;
  }

  .auth-card {
    padding: var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  .auth-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-gradient);
  }

  .auth-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .auth-header h1 {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: 1.5rem;
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-subtle);
  }

  .password-strength {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: 0.5rem;
  }

  .strength-bar {
    flex: 1;
    height: 4px;
    background: var(--bg-glass-strong);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .strength-fill {
    height: 100%;
    width: 0%;
    border-radius: var(--radius-full);
    transition: all var(--transition-base);
    background: var(--error);
  }

  .strength-text {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .auth-error {
    margin-top: var(--space-md);
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error);
    font-size: 0.85rem;
    text-align: center;
  }

  .auth-success {
    margin-top: var(--space-md);
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--success-bg);
    border: 1px solid var(--success-border);
    color: var(--success);
    font-size: 0.85rem;
    text-align: center;
  }

  .auth-footer {
    margin-top: var(--space-xl);
    text-align: center;
    font-size: 0.9rem;
  }

  /* Email Verification Prompted Card */
  .verification-hero {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .mail-badge-icon {
    position: relative;
    width: 68px;
    height: 68px;
    margin: 0.5rem auto 1.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(168, 85, 247, 0.15));
    border: 1px solid rgba(99, 102, 241, 0.3);
    box-shadow: 0 0 24px rgba(99, 102, 241, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary, #6366f1);
  }

  .check-floating-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #10b981;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--bg-surface, #1e293b);
    box-shadow: 0 2px 6px rgba(16, 185, 129, 0.4);
  }

  .verification-title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    color: var(--text-primary);
  }

  .verification-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }

  .email-pill-box {
    display: inline-block;
    max-width: 100%;
    padding: 0.45rem 1rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 9999px;
    color: var(--accent-primary, #6366f1);
    font-weight: 600;
    font-size: 0.92rem;
    word-break: break-all;
  }

  .verification-info-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    margin: 1.25rem 0 1.5rem;
    text-align: left;
  }

  .info-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .info-item:not(:last-child) {
    margin-bottom: 0.75rem;
  }

  .info-bullet {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent-primary, #6366f1);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }

  .info-item p {
    font-size: 0.83rem;
    color: var(--text-secondary);
    line-height: 1.45;
    margin: 0;
  }

  .info-item p strong {
    color: var(--text-primary);
  }

  .link-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: underline;
    padding: 0.25rem;
    transition: color var(--transition-fast);
  }

  .link-btn:hover {
    color: var(--text-primary);
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { validateAllowedEmail } from '../../lib/emailValidation';
  import { getAuthConfig } from '../../lib/api';

  // Instant session check: If already logged in, redirect directly
  async function checkSessionAndRedirect() {
    const { data: { session } } = await supabase.auth.getSession();
    if (session?.user) {
      // Validate user email against rules
      const validation = validateAllowedEmail(session.user.email || '');
      if (!validation.valid) {
        await supabase.auth.signOut();
        const errDiv = document.getElementById('register-error');
        if (errDiv) {
          errDiv.textContent = validation.error || 'This email domain is not permitted.';
          errDiv.style.display = 'block';
        }
        return;
      }

      const card = document.querySelector('.auth-card') as HTMLElement;
      if (card) {
        card.innerHTML = `
          <div style="text-align: center; padding: 2rem 1rem;">
            <div class="spinner spinner-lg" style="margin: 0 auto 1.25rem;"></div>
            <h3 style="margin: 0 0 0.5rem; font-size: 1.25rem; font-weight: 700;">Already Signed In</h3>
            <p style="color: var(--text-secondary); font-size: 0.9rem; margin: 0;">Redirecting to your dashboard...</p>
          </div>
        `;
      }
      try {
        const { data: profile } = await supabase
          .from('profiles')
          .select('role')
          .eq('id', session.user.id)
          .single();
        if (profile?.role === 'admin') {
          window.location.href = '/admin';
          return;
        }
      } catch {}
      window.location.href = '/dashboard';
    }
  }

  checkSessionAndRedirect();
  supabase.auth.onAuthStateChange((_event, session) => {
    if (session?.user) {
      checkSessionAndRedirect();
    }
  });

  const form = document.getElementById('register-form') as HTMLFormElement;
  const errorEl = document.getElementById('register-error') as HTMLElement;
  const successEl = document.getElementById('register-success') as HTMLElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;

  const strengthFill = document.getElementById('strength-fill') as HTMLElement;
  const strengthText = document.getElementById('strength-text') as HTMLElement;
  const googleWrapper = document.getElementById('google-signup-wrapper') as HTMLElement;
  const googleBtn = document.getElementById('google-signup-btn') as HTMLButtonElement;
  const regClosedNotice = document.getElementById('registration-closed-notice') as HTMLElement;
  const emailDisabledNotice = document.getElementById('email-signup-disabled-notice') as HTMLElement;
  const refCodeInput = document.getElementById('referral-code') as HTMLInputElement;

  // Detect referral code from URL query (?ref=CODE) or localStorage
  try {
    const urlParams = new URLSearchParams(window.location.search);
    const refParam = urlParams.get('ref') || urlParams.get('referral');
    if (refParam) {
      const cleanRef = refParam.trim().toUpperCase();
      localStorage.setItem('otpwala_ref_code', cleanRef);
      if (refCodeInput) refCodeInput.value = cleanRef;
    } else {
      const savedRef = localStorage.getItem('otpwala_ref_code');
      if (savedRef && refCodeInput) {
        refCodeInput.value = savedRef;
      }
    }
  } catch {}

  // Apply Auth Config from Admin Settings
  let authConfig = { allowEmailSignup: true, allowGoogleLogin: true, allowRegistration: true };

  (async () => {
    try {
      const res = await getAuthConfig();
      if (res) authConfig = res;
    } catch {
      // default to open
    }

    const root = document.documentElement;

    if (!authConfig.allowRegistration) {
      root.classList.add('auth-config-no-reg');
      if (regClosedNotice) regClosedNotice.style.display = 'block';
      if (googleWrapper) googleWrapper.style.display = 'none';
      if (form) form.style.display = 'none';
      return;
    } else {
      root.classList.remove('auth-config-no-reg');
      if (regClosedNotice) regClosedNotice.style.display = 'none';
    }

    if (!authConfig.allowGoogleLogin) {
      root.classList.add('auth-config-no-google');
      if (googleWrapper) googleWrapper.style.display = 'none';
    } else {
      root.classList.remove('auth-config-no-google');
      if (googleWrapper) googleWrapper.style.display = 'block';
    }

    if (!authConfig.allowEmailSignup) {
      root.classList.add('auth-config-no-email');
      if (emailDisabledNotice) emailDisabledNotice.style.display = 'block';
      if (form) form.style.display = 'none';
    } else {
      root.classList.remove('auth-config-no-email');
      if (emailDisabledNotice) emailDisabledNotice.style.display = 'none';
      if (form) form.style.display = 'block';
    }
  })();

  // Password strength indicator
  passwordInput?.addEventListener('input', () => {
    const val = passwordInput.value;
    let score = 0;
    if (val.length >= 8) score++;
    if (val.length >= 12) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const pct = (score / 5) * 100;
    strengthFill.style.width = pct + '%';

    if (score <= 1) {
      strengthFill.style.background = 'var(--error)';
      strengthText.textContent = 'Weak';
    } else if (score <= 3) {
      strengthFill.style.background = 'var(--warning)';
      strengthText.textContent = 'Medium';
    } else {
      strengthFill.style.background = 'var(--success)';
      strengthText.textContent = 'Strong';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.style.display = 'none';
    successEl.style.display = 'none';

    if (!authConfig.allowRegistration) {
      errorEl.textContent = 'Registrations are currently closed by administrator.';
      errorEl.style.display = 'block';
      return;
    }

    if (!authConfig.allowEmailSignup) {
      errorEl.textContent = 'Standard email registration is currently paused.';
      errorEl.style.display = 'block';
      return;
    }

    const name = (document.getElementById('name') as HTMLInputElement).value.trim();
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const referralCode = ((document.getElementById('referral-code') as HTMLInputElement)?.value || '').trim().toUpperCase();

    if (referralCode) {
      try {
        localStorage.setItem('otpwala_ref_code', referralCode);
      } catch {}
    }

    // Strict Email Validation (Gmail, Yahoo, Hotmail, Outlook; no dots, no + aliases)
    const emailVal = validateAllowedEmail(email);
    if (!emailVal.valid) {
      errorEl.textContent = emailVal.error || 'Please enter a valid allowed email address.';
      errorEl.style.display = 'block';
      return;
    }

    const submitBtn = document.getElementById('register-submit-btn') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Verifying...';
    }

    try {
      const targetEmail = emailVal.cleanedEmail || email;
      const apiUrl = (window as any).__PUBLIC_API_URL__ || import.meta.env.PUBLIC_API_URL || 'https://api.otpwala.me';

      // 1. Pre-check if email already exists before triggering Supabase signUp
      // This completely prevents duplicate accounts and prevents Supabase from sending unnecessary verification emails
      try {
        const checkRes = await fetch(`${apiUrl}/api/auth/check-email`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: targetEmail }),
        });
        if (checkRes.ok) {
          const checkData = await checkRes.json();
          if (checkData?.exists) {
            errorEl.innerHTML = 'An account with this email already exists. <a href="/auth/login" style="color: var(--accent-primary, #6366f1); text-decoration: underline; font-weight: 600;">Log in here</a> or <a href="/auth/forgot-password" style="color: var(--accent-primary, #6366f1); text-decoration: underline;">reset password</a>.';
            errorEl.style.display = 'block';
            return;
          }
        }
      } catch (checkErr) {
        console.warn('Email pre-check error, falling back to direct signup:', checkErr);
      }

      if (submitBtn) {
        submitBtn.textContent = 'Creating account...';
      }

      const { data, error } = await supabase.auth.signUp({
        email: targetEmail,
        password,
        options: { data: { full_name: name, referral_code: referralCode || null } },
      });

      if (error) {
        const msg = error.message || '';
        if (msg.toLowerCase().includes('already registered') || msg.toLowerCase().includes('already exists')) {
          errorEl.innerHTML = 'An account with this email already exists. <a href="/auth/login" style="color: var(--accent-primary, #6366f1); text-decoration: underline; font-weight: 600;">Log in here</a>.';
        } else {
          errorEl.textContent = msg;
        }
        errorEl.style.display = 'block';
        return;
      }

      // Supabase Anti-Enumeration check:
      // When a user already exists and Supabase has user enumeration protection enabled,
      // it returns error = null, BUT data.user.identities is an empty array [].
      if (data?.user && (!data.user.identities || data.user.identities.length === 0)) {
        errorEl.innerHTML = 'An account with this email already exists. <a href="/auth/login" style="color: var(--accent-primary, #6366f1); text-decoration: underline; font-weight: 600;">Log in here</a> or <a href="/auth/forgot-password" style="color: var(--accent-primary, #6366f1); text-decoration: underline;">reset password</a>.';
        errorEl.style.display = 'block';
        return;
      }

      // Successfully created account!
      // Replace the form with a dedicated, beautiful Check Your Email prompt card
      const header = document.getElementById('register-header');
      const formRoot = document.getElementById('register-form-root');
      const checkEmailCard = document.getElementById('check-email-card');
      const footer = document.getElementById('register-footer');
      const emailPill = document.getElementById('registered-email-pill');

      if (header) header.style.display = 'none';
      if (formRoot) formRoot.style.display = 'none';
      if (footer) footer.style.display = 'none';
      if (emailPill) emailPill.textContent = targetEmail;
      if (checkEmailCard) {
        checkEmailCard.style.display = 'block';
        checkEmailCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      lastRegisteredEmail = targetEmail;
    } catch (err: any) {
      errorEl.textContent = err.message || 'Registration failed';
      errorEl.style.display = 'block';
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Create Account';
      }
    }
  });

  // Resend verification email handling
  let lastRegisteredEmail = '';
  let resendCooldown = 0;
  let resendInterval: any = null;

  const resendBtn = document.getElementById('resend-verification-btn') as HTMLButtonElement | null;
  const resendFeedback = document.getElementById('resend-feedback') as HTMLElement | null;

  resendBtn?.addEventListener('click', async () => {
    if (resendCooldown > 0 || !lastRegisteredEmail) return;

    resendBtn.disabled = true;
    resendBtn.textContent = 'Sending...';
    if (resendFeedback) resendFeedback.style.display = 'none';

    try {
      const { error } = await supabase.auth.resend({
        type: 'signup',
        email: lastRegisteredEmail,
      });

      if (error) {
        if (resendFeedback) {
          resendFeedback.textContent = error.message;
          resendFeedback.style.color = 'var(--error)';
          resendFeedback.style.display = 'block';
        }
      } else {
        if (resendFeedback) {
          resendFeedback.textContent = 'Verification email sent! Check your inbox.';
          resendFeedback.style.color = 'var(--success)';
          resendFeedback.style.display = 'block';
        }
      }
    } catch (err: any) {
      if (resendFeedback) {
        resendFeedback.textContent = err.message || 'Failed to resend verification email';
        resendFeedback.style.color = 'var(--error)';
        resendFeedback.style.display = 'block';
      }
    }

    // Start 60s cooldown
    resendCooldown = 60;
    resendBtn.disabled = true;
    resendBtn.textContent = `Resend in ${resendCooldown}s`;
    if (resendInterval) clearInterval(resendInterval);
    resendInterval = setInterval(() => {
      resendCooldown--;
      if (resendCooldown <= 0) {
        clearInterval(resendInterval);
        if (resendBtn) {
          resendBtn.disabled = false;
          resendBtn.textContent = 'Resend Verification Email';
        }
      } else {
        if (resendBtn) resendBtn.textContent = `Resend in ${resendCooldown}s`;
      }
    }, 1000);
  });

  // Change email / Register again
  const changeEmailBtn = document.getElementById('change-email-btn');
  changeEmailBtn?.addEventListener('click', () => {
    const header = document.getElementById('register-header');
    const formRoot = document.getElementById('register-form-root');
    const checkEmailCard = document.getElementById('check-email-card');
    const footer = document.getElementById('register-footer');

    if (checkEmailCard) checkEmailCard.style.display = 'none';
    if (header) header.style.display = 'block';
    if (formRoot) formRoot.style.display = 'block';
    if (footer) footer.style.display = 'block';

    form?.reset();
    const emailInput = document.getElementById('email') as HTMLInputElement | null;
    emailInput?.focus();
  });

  googleBtn?.addEventListener('click', async () => {
    if (!authConfig.allowRegistration || !authConfig.allowGoogleLogin) {
      errorEl.textContent = 'Google sign up is currently disabled.';
      errorEl.style.display = 'block';
      return;
    }

    try {
      await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: window.location.origin + '/dashboard' },
      });
    } catch (err: any) {
      errorEl.textContent = err.message || 'Google sign up failed';
      errorEl.style.display = 'block';
    }
  });
</script>
