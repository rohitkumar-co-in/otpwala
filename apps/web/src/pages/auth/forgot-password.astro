---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Forgot Password — OTPWala" 
  description="Reset your OTPWala account password. Enter your email to receive recovery instructions."
  canonical="https://otpwala.me/auth/forgot-password"
>
  <section class="auth-page">
    <div class="auth-container">
      <div class="auth-card card-glass">
        <!-- Brand / Header -->
        <div class="auth-header">
          <div class="auth-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h1>Reset Password</h1>
          <p class="text-secondary" id="reset-subhead">Enter your email and we'll send you recovery instructions.</p>
        </div>

        <div id="forgot-root">
          <!-- Step 1: Request Reset -->
          <form id="forgot-form">
            <div class="input-group" style="margin-bottom: 1.5rem;">
              <label for="forgot-email">Email Address</label>
              <input 
                type="email" 
                id="forgot-email" 
                class="input" 
                placeholder="you@example.com" 
                autocomplete="email"
                required 
              />
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;" id="send-reset-btn">
              <span class="btn-text">Send Reset Instructions</span>
              <span class="btn-loading spinner spinner-sm" style="display: none;"></span>
            </button>
          </form>

          <!-- Step 2: Code Verification Fallback (Shown after email sent) -->
          <div id="recovery-code-panel" style="display: none; margin-top: 1.5rem;">
            <div class="auth-success-alert">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>Recovery instructions sent! Check your inbox for the link or 6-digit code.</span>
            </div>

            <form id="recovery-code-form" style="margin-top: 1.25rem;">
              <div class="input-group" style="margin-bottom: 1rem;">
                <label for="recovery-code">Recovery Code</label>
                <input 
                  type="text" 
                  id="recovery-code" 
                  class="input otp-input" 
                  placeholder="••••••" 
                  maxlength="6"
                  pattern="[0-9]{6}"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                />
                <span class="input-hint" style="text-align: center;">Enter the 6-digit code from your email</span>
              </div>

              <div class="input-group" style="margin-bottom: 1rem;">
                <label for="recovery-new-password">New Password</label>
                <input 
                  type="password" 
                  id="recovery-new-password" 
                  class="input" 
                  placeholder="Minimum 8 characters" 
                  minlength="8"
                />
              </div>

              <div class="input-group" style="margin-bottom: 1.5rem;">
                <label for="recovery-confirm-password">Confirm New Password</label>
                <input 
                  type="password" 
                  id="recovery-confirm-password" 
                  class="input" 
                  placeholder="Re-enter new password" 
                  minlength="8"
                />
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%;" id="reset-code-btn">
                <span class="btn-text">Reset Password</span>
                <span class="btn-loading spinner spinner-sm" style="display: none;"></span>
              </button>
            </form>
          </div>

          <!-- Alert Notices -->
          <div id="forgot-error" class="auth-error" style="display: none;"></div>
          <div id="forgot-success" class="auth-success" style="display: none;"></div>
        </div>

        <div class="auth-footer">
          <p class="text-secondary">
            Remember your password? <a href="/auth/login">Back to Login</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - var(--header-height));
    padding: var(--space-2xl) var(--space-md);
    background: #fafafa;
  }

  .auth-container {
    width: 100%;
    max-width: 440px;
  }

  .auth-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    padding: var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  .auth-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-gradient);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .auth-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: rgba(37, 99, 235, 0.08);
    color: var(--accent-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .auth-header h1 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 0.35rem;
    color: var(--text-primary);
  }

  .otp-input {
    font-family: var(--font-mono);
    letter-spacing: 0.35em;
    text-align: center;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .otp-input::placeholder {
    letter-spacing: 0.25em;
    color: var(--text-muted);
    font-weight: 400;
    opacity: 0.55;
  }

  .input-hint {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.35rem;
    display: block;
  }

  .auth-error {
    margin-top: 1rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    background: var(--error-bg);
    border: 1px solid var(--error-border);
    color: var(--error);
    font-size: 0.85rem;
    text-align: center;
  }

  .auth-success {
    margin-top: 1rem;
    padding: 0.85rem;
    border-radius: var(--radius-md);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #065f46;
    font-size: 0.88rem;
    text-align: center;
    font-weight: 500;
  }

  .auth-success-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.85rem;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-md);
    color: #047857;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .auth-success-alert svg {
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .auth-footer {
    margin-top: 1.75rem;
    text-align: center;
    font-size: 0.9rem;
    border-top: 1px solid #f1f5f9;
    padding-top: 1.25rem;
  }

  .auth-footer a {
    color: var(--accent-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .auth-footer a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { validateAllowedEmail } from '../../lib/emailValidation';

  const forgotForm = document.getElementById('forgot-form') as HTMLFormElement;
  const forgotEmailInput = document.getElementById('forgot-email') as HTMLInputElement;
  const sendResetBtn = document.getElementById('send-reset-btn') as HTMLButtonElement;
  const recoveryPanel = document.getElementById('recovery-code-panel') as HTMLElement;
  const recoveryForm = document.getElementById('recovery-code-form') as HTMLFormElement;
  const recoveryCodeInput = document.getElementById('recovery-code') as HTMLInputElement;
  const newPasswordInput = document.getElementById('recovery-new-password') as HTMLInputElement;
  const confirmPasswordInput = document.getElementById('recovery-confirm-password') as HTMLInputElement;
  const resetCodeBtn = document.getElementById('reset-code-btn') as HTMLButtonElement;
  const errorEl = document.getElementById('forgot-error') as HTMLElement;
  const successEl = document.getElementById('forgot-success') as HTMLElement;

  let activeEmail = '';

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.style.display = 'block';
    if (successEl) successEl.style.display = 'none';
  }

  function showSuccess(msg: string) {
    if (!successEl) return;
    successEl.textContent = msg;
    successEl.style.display = 'block';
    if (errorEl) errorEl.style.display = 'none';
  }

  function clearAlerts() {
    if (errorEl) errorEl.style.display = 'none';
    if (successEl) successEl.style.display = 'none';
  }

  // Handle Step 1: Send Reset Instructions
  forgotForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearAlerts();

    const email = forgotEmailInput.value.trim();
    const emailVal = validateAllowedEmail(email);
    if (!emailVal.valid) {
      showError(emailVal.error || 'Please enter a valid allowed email address.');
      return;
    }

    activeEmail = emailVal.cleanedEmail || email;
    sendResetBtn.disabled = true;
    sendResetBtn.querySelector('.btn-text')!.textContent = 'Sending instructions...';
    (sendResetBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'inline-block';

    try {
      const { error } = await supabase.auth.resetPasswordForEmail(activeEmail, {
        redirectTo: window.location.origin + '/auth/reset-password'
      });

      if (error) {
        showError(error.message);
        return;
      }

      showSuccess('Instructions sent! Check your email for the reset link or 6-digit code.');
      forgotForm.style.display = 'none';
      recoveryPanel.style.display = 'block';
    } catch (err: any) {
      showError(err.message || 'Failed to send reset email. Please try again.');
    } finally {
      sendResetBtn.disabled = false;
      sendResetBtn.querySelector('.btn-text')!.textContent = 'Send Reset Instructions';
      (sendResetBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
    }
  });

  // Restrict recovery code input to numbers only (up to 6 digits)
  recoveryCodeInput?.addEventListener('input', () => {
    recoveryCodeInput.value = recoveryCodeInput.value.replace(/\D/g, '').slice(0, 6);
  });

  // Handle Step 2: Direct OTP Recovery Fallback
  recoveryForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearAlerts();

    const code = recoveryCodeInput.value.trim().replace(/\s+/g, '');
    const newPass = newPasswordInput.value;
    const confirmPass = confirmPasswordInput.value;

    if (!code || code.length !== 6 || !/^\d{6}$/.test(code)) {
      showError('Please enter the 6-digit verification code from your email.');
      return;
    }

    if (newPass.length < 8) {
      showError('Password must be at least 8 characters long.');
      return;
    }

    if (newPass !== confirmPass) {
      showError('Passwords do not match.');
      return;
    }

    resetCodeBtn.disabled = true;
    resetCodeBtn.querySelector('.btn-text')!.textContent = 'Updating password...';
    (resetCodeBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'inline-block';

    try {
      // 1. Verify recovery OTP
      const { error: otpError } = await supabase.auth.verifyOtp({
        email: activeEmail,
        token: code,
        type: 'recovery'
      });

      if (otpError) {
        showError(otpError.message);
        return;
      }

      // 2. Set new password
      const { error: updateError } = await supabase.auth.updateUser({
        password: newPass
      });

      if (updateError) {
        showError(updateError.message);
        return;
      }

      showSuccess('Password reset successfully! Redirecting to your dashboard...');
      recoveryForm.reset();
      setTimeout(() => {
        window.location.href = '/dashboard';
      }, 1500);
    } catch (err: any) {
      showError(err.message || 'Failed to reset password. Please try again.');
    } finally {
      resetCodeBtn.disabled = false;
      resetCodeBtn.querySelector('.btn-text')!.textContent = 'Reset Password';
      (resetCodeBtn.querySelector('.btn-loading') as HTMLElement).style.display = 'none';
    }
  });
</script>
