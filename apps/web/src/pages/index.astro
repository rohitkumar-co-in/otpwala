<script>
  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.reveal, .reveal-card').forEach(el => observer.observe(el));

  // Animated OTP cycling
  const otpEl = document.getElementById('animated-otp');
  const otps = ['582941', '371064', '925837', '147296'];
  let idx = 0;
  setInterval(() => {
    idx = (idx + 1) % otps.length;
    if (otpEl) otpEl.textContent = otps[idx];
  }, 4000);

  // Phone service cycling animation
  const rows = document.querySelectorAll('.ps-row');
  const statuses = [
    ['ps-received', 'OTP Received'],
    ['ps-waiting',  'Waiting...'],
    ['ps-idle',     'Ready'],
  ];
  let serviceIdx = 0;
  setInterval(() => {
    rows.forEach((r, i) => {
      const span = r.querySelector('.ps-status');
      if (!span) return;
      const status = statuses[(i + serviceIdx) % statuses.length];
      span.className = 'ps-status ' + status[0];
      span.textContent = status[1];
    });
    serviceIdx = (serviceIdx + 1) % statuses.length;
  }, 3500);

  const API_URL = (window as any).__PUBLIC_API_URL__ !== undefined
    ? (window as any).__PUBLIC_API_URL__
    : (import.meta.env.PUBLIC_API_URL || '');
  fetch(API_URL + '/api/catalog/summary')
    .then((response) => response.json())
    .then((result) => {
      if (!result.success || !result.data) return;
      const serviceCount = Number(result.data.serviceCount || 0);
      const countryCount = Number(result.data.countryCount || 0);
      const serviceEl = document.getElementById('home-service-count');
      const countryEl = document.getElementById('home-country-count');
      if (serviceEl) serviceEl.textContent = serviceCount ? `${serviceCount}+` : 'Live';
      if (countryEl) countryEl.textContent = countryCount ? `${countryCount}+` : 'Live';
    })
    .catch(() => {});

</script>
