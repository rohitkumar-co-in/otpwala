---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is OTPWala and how does it work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "OTPWala is a high-speed platform providing temporary virtual phone numbers to receive SMS verification codes (OTPs) for services like WhatsApp, Telegram, Google, and Instagram without revealing your personal phone number."
      }
    },
    {
      "@type": "Question",
      "name": "How fast do I receive SMS verification codes on OTPWala?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Delivery time depends on the selected service, country, and current number availability. Your dashboard shows live order status updates."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I do not receive an SMS code? Do I get a refund?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eligible cancelled orders are refunded after cancellation is confirmed. Wallet credit can take 2–5 minutes to appear."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use OTPWala numbers for WhatsApp, Telegram, and Google?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "OTPWala displays the services and countries currently available in its live catalog."
      }
    },
    {
      "@type": "Question",
      "name": "How do I top up my wallet on OTPWala?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can add balance using supported Indian UPI payment apps. The current number price is shown after you select a service and country."
      }
    },
    {
      "@type": "Question",
      "name": "Are virtual phone numbers safe and private?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Each number is provisioned for your exclusive verification session, protecting your personal SIM card and identity from spam, data brokers, and trackers."
      }
    }
  ]
};
