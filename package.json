{
  "name": "otpwala",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @otpwala/web dev",
    "dev:api": "pnpm --filter @otpwala/api dev",
    "build": "npm --prefix apps/web run build && node -e \"const fs=require('fs'); if(fs.existsSync('apps/web/dist')){fs.cpSync('apps/web/dist','dist',{recursive:true});}\"",
    "build:web": "npm --prefix apps/web run build",
    "build:api": "pnpm --filter @otpwala/api build",
    "deploy:web": "npm --prefix apps/web run build && npx wrangler pages deploy dist --project-name=otpwala --cwd apps/web --commit-dirty=true",
    "test:guardrails": "node scripts/production-guardrails.mjs",
    "test:unit": "node --experimental-strip-types --test functions/lib/*.test.ts",
    "test:provider-pricing": "node apps/api/node_modules/tsx/dist/cli.mjs --test scripts/provider-pricing.test.ts",
    "test:smoke": "node scripts/smoke-production.mjs",
    "verify:production": "npm run build && npm --prefix apps/api run build && npm run test:unit && npm run test:provider-pricing && npm run test:guardrails && npm run test:smoke",
    "clean": "node -e \"const fs=require('fs'); ['dist','apps/web/dist','apps/api/dist','apps/web/.astro'].forEach(p=>{if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})})\"",
    "clean:all": "node -e \"const fs=require('fs'); ['dist','apps/web/dist','apps/api/dist','apps/web/.astro','node_modules','apps/web/node_modules','apps/api/node_modules'].forEach(p=>{if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})})\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "wrangler": "4.137.0"
  }
}
